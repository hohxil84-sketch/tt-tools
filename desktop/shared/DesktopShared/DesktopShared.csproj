<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TTShared</RootNamespace>
    <AssemblyName>TTShared</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>TT Tools Team</Authors>
    <Description>TT Tools - 桌面端公共层，包含认证、云端 API、本地 runtime、文件系统、任务系统、日志、设置和通用 UI 组件</Description>
  </PropertyGroup>

  <!-- 全局隐式 using：补充 net8.0-windows WPF 库项目未自动包含的常用命名空间 -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Net.Http.Json" />
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
  </ItemGroup>

  <!-- 安全存储依赖：System.Security.Cryptography.ProtectedData 提供 Windows DPAPI 加密 -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
