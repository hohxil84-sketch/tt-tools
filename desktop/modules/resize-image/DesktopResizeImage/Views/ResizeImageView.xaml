<UserControl x:Class="TTTools.ResizeImage.Views.ResizeImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TTTools.ResizeImage.Views"
             xmlns:vm="clr-namespace:TTTools.ResizeImage.ViewModels"
             xmlns:models="clr-namespace:TTTools.ResizeImage.Models"
             MinWidth="700" MinHeight="500">

    <UserControl.Resources>
        <!-- Bool 取反转换器 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 第1行：工具栏 ===== -->
        <Border Grid.Row="0" Padding="8,6" Margin="0,0,0,8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 服务状态 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#4CAF50" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceAvailable}" Value="False">
                                        <Setter Property="Fill" Value="#9E9E9E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ServiceStatusText}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1" Content="选择图片" Width="90" Height="30"
                        Command="{Binding SelectFilesCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="开始改尺寸" Width="100" Height="30"
                        Command="{Binding StartProcessingCommand}"
                        IsEnabled="{Binding CanStart}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3182CE" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#A0C4E8" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="3" Content="取消" Width="60" Height="30"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding CanCancel}" HorizontalAlignment="Left" />

                <Button Grid.Column="4" Content="清除结果" Width="80" Height="30"
                        Command="{Binding ClearResultsCommand}" />
            </Grid>
        </Border>

        <!-- ===== 第2行：错误消息 ===== -->
        <Border Grid.Row="1" Background="#FDE8E8" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C53030" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- ===== 第3行：改尺寸参数配置 ===== -->
        <Border Grid.Row="2" Padding="10,8" Margin="0,0,0,8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="改尺寸参数" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <WrapPanel Margin="0,0,0,4">
                    <!-- 模式选择 -->
                    <StackPanel Margin="0,0,12,4" Width="280">
                        <TextBlock Text="缩放模式" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <ComboBox SelectedValue="{Binding SelectedMode}" SelectedValuePath="Tag" Height="28">
                            <ComboBoxItem Content="等比适配 - 不超出边界保持比例" Tag="fit" />
                            <ComboBoxItem Content="精确尺寸 - 拉伸到指定宽高" Tag="exact" />
                            <ComboBoxItem Content="等比填充 - 填满边界居中裁剪" Tag="fill" />
                            <ComboBoxItem Content="百分比缩放 - 按比例放大缩小" Tag="scale" />
                            <ComboBoxItem Content="短边约束 - 短边对齐长边自适应" Tag="short_side" />
                            <ComboBoxItem Content="长边约束 - 长边对齐短边自适应" Tag="long_side" />
                            <ComboBoxItem Content="按 DPI 缩放 - 根据目标 DPI 计算" Tag="custom_dpi" />
                        </ComboBox>
                    </StackPanel>

                    <!-- 预设选择 -->
                    <StackPanel Margin="0,0,12,4" Width="280">
                        <TextBlock Text="预设尺寸" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding AvailablePresets}"
                                  SelectedValue="{Binding SelectedPreset}"
                                  DisplayMemberPath="DisplayText" SelectedValuePath="Name" Height="28" />
                    </StackPanel>

                    <!-- 重采样 -->
                    <StackPanel Margin="0,0,12,4" Width="280">
                        <TextBlock Text="重采样滤镜" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <ComboBox SelectedValue="{Binding SelectedResample}" SelectedValuePath="Tag" Height="28">
                            <ComboBoxItem Content="Lanczos (推荐，最佳质量)" Tag="lanczos" />
                            <ComboBoxItem Content="Bilinear (较快，适合缩小)" Tag="bilinear" />
                            <ComboBoxItem Content="Bicubic (较慢，适合放大)" Tag="bicubic" />
                            <ComboBoxItem Content="Nearest (最快，像素风格)" Tag="nearest" />
                            <ComboBoxItem Content="Box (区域平均)" Tag="box" />
                            <ComboBoxItem Content="Hamming (Sinc 插值)" Tag="hamming" />
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel>
                    <!-- 宽高（FIT/EXACT/FILL） -->
                    <StackPanel Margin="0,0,12,4" Width="130"
                                Visibility="{Binding ShowWidthHeight, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="宽度 (px)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,4" Width="130"
                                Visibility="{Binding ShowWidthHeight, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="高度 (px)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                    </StackPanel>

                    <!-- 保持宽高比（EXACT） -->
                    <CheckBox Content="保持宽高比" IsChecked="{Binding KeepAspect}" Margin="0,8,12,4" VerticalAlignment="Center"
                              Visibility="{Binding ShowKeepAspect, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 缩放百分比（SCALE） -->
                    <StackPanel Margin="0,0,12,4" Width="130"
                                Visibility="{Binding ShowScalePercent, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="缩放百分比" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding ScalePercent, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                    </StackPanel>

                    <!-- 短边（SHORT_SIDE） -->
                    <StackPanel Margin="0,0,12,4" Width="130"
                                Visibility="{Binding ShowShortSide, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="短边目标 (px)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding ShortSide, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                    </StackPanel>

                    <!-- 长边（LONG_SIDE） -->
                    <StackPanel Margin="0,0,12,4" Width="130"
                                Visibility="{Binding ShowLongSide, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="长边目标 (px)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding LongSide, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                    </StackPanel>

                    <!-- 目标 DPI（CUSTOM_DPI） -->
                    <StackPanel Margin="0,0,12,4" Width="130"
                                Visibility="{Binding ShowTargetDpi, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="目标 DPI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding TargetDpi, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                    </StackPanel>
                </WrapPanel>

                <!-- 输出格式和质量 -->
                <WrapPanel Margin="0,4,0,0">
                    <StackPanel Margin="0,0,12,4" Width="200">
                        <TextBlock Text="输出格式" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <ComboBox SelectedValue="{Binding SelectedOutputFormat}" SelectedValuePath="Tag" Height="28">
                            <ComboBoxItem Content="保持原格式" Tag="original" />
                            <ComboBoxItem Content="PNG - 无损，支持透明" Tag="png" />
                            <ComboBoxItem Content="JPEG - 有损，文件小" Tag="jpeg" />
                            <ComboBoxItem Content="BMP - 无压缩，Windows 标准" Tag="bmp" />
                            <ComboBoxItem Content="TIFF - 印刷标准，LZW 压缩" Tag="tiff" />
                            <ComboBoxItem Content="WEBP - Web 优化格式" Tag="webp" />
                        </ComboBox>
                    </StackPanel>

                    <!-- JPEG 质量 -->
                    <StackPanel Margin="0,0,12,4" Width="180"
                                Visibility="{Binding ShowJpegQuality, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="JPEG 质量 (1-100)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding JpegQuality, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                    </StackPanel>

                    <!-- PNG 压缩 -->
                    <StackPanel Margin="0,0,12,4" Width="180"
                                Visibility="{Binding ShowPngCompress, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="PNG 压缩级别 (0-9)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding PngCompressLevel, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                    </StackPanel>

                    <!-- WEBP 质量 -->
                    <StackPanel Margin="0,0,12,4" Width="180"
                                Visibility="{Binding ShowWebpQuality, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="WEBP 质量 (1-100)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding WebpQuality, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                    </StackPanel>

                    <!-- 自定义 DPI（非 original 格式时显示） -->
                    <StackPanel Margin="0,0,12,4" Width="120">
                        <TextBlock Text="输出 DPI X" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding CustomDpiX, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,4" Width="120">
                        <TextBlock Text="输出 DPI Y" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding CustomDpiY, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ===== 第4行：进度条 ===== -->
        <Grid Grid.Row="3" Margin="0,0,0,6" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}" Height="8"
                         Foreground="#3182CE" BorderThickness="0" />
        </Grid>

        <!-- ===== 第5行：主内容区（结果列表 + 详情预览） ===== -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：结果列表 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="处理结果" FontWeight="SemiBold" FontSize="13"
                               Margin="10,8" Foreground="{DynamicResource TextPrimaryBrush}" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult}" Margin="4,0,4,6"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ResizeImageResult}">
                                <Border Padding="8,6" Margin="0,0,0,2" CornerRadius="4"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding InputFileName}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding SizeSummary}" />

                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <!-- 状态标签 -->
                                            <Border CornerRadius="2" Padding="4,1" Margin="0,3,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E6FFED" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                                <Setter Property="Background" Value="#FEE2E2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="成功" />
                                                            <Setter Property="Foreground" Value="#1B873B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                                    <Setter Property="Text" Value="失败" />
                                                                    <Setter Property="Foreground" Value="#C53030" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- 权限状态 -->
                                            <Border CornerRadius="2" Padding="4,1" Margin="4,3,0,0"
                                                    Visibility="{Binding HasPermission, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DBEAFE" />
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="已授权" FontSize="10" Foreground="#1E40AF" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- 右侧：详情预览 -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="详情预览" FontWeight="SemiBold" FontSize="14"
                               Margin="0,0,0,12" Foreground="{DynamicResource TextPrimaryBrush}" />

                    <!-- 权限拒绝提示 -->
                    <Border Grid.Row="1" Background="#FFF8E1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8"
                            Visibility="{Binding SelectedResult.HasPermission, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedResult.HasPermission}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="权限不足" FontWeight="SemiBold" FontSize="13" Foreground="#D97706" />
                            <TextBlock Text="{Binding SelectedResult.EntitlementReason}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 结果详情 -->
                    <Border Grid.Row="2" Padding="12" Background="{DynamicResource BackgroundBrush}" CornerRadius="4"
                            Visibility="{Binding HasSelectedResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPreviewText}" FontSize="13" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <!-- 警告信息 -->
                            <ItemsControl ItemsSource="{Binding SelectedResult.Warnings}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#D97706" FontSize="11" TextWrapping="Wrap">
                                            <Run Text="⚠ " /><Run Text="{Binding}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Visibility>
                                    <Binding Path="SelectedResult.HasWarnings" Converter="{StaticResource BoolToVisibility}" />
                                </ItemsControl.Visibility>
                            </ItemsControl>

                            <Button Content="打开文件所在位置" Width="160" Height="28" Margin="0,10,0,0"
                                    Command="{Binding OpenOutputFileCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- 未选择结果时的提示 -->
                    <TextBlock Grid.Row="3" Text="选择左侧处理结果查看详情，或拖拽图片文件到窗口开始处理"
                               FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelectedResult, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedResult}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 第6行：状态栏 ===== -->
        <Border Grid.Row="5" Padding="8,4" Margin="0,6,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text=" | " Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}">
                    <Run Text="共 " /><Run Text="{Binding ResultCount, Mode=OneWay}" /><Run Text=" 条 (成功 " />
                    <Run Text="{Binding SuccessCount, Mode=OneWay}" /><Run Text=", 失败 " /><Run Text="{Binding FailedCount, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
