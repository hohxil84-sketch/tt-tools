<UserControl x:Class="TTTools.IdPhoto.Views.IdPhotoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TTTools.IdPhoto.Views"
             xmlns:vm="clr-namespace:TTTools.IdPhoto.ViewModels"
             xmlns:models="clr-namespace:TTTools.IdPhoto.Models"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000"
             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 成功状态颜色 -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
        <!-- 错误状态颜色 -->
        <SolidColorBrush x:Key="ErrorBrush" Color="#C62828"/>

        <!-- 底色转换器 -->
        <local:ColorItemToBrushConverter x:Key="ColorItemToBrushConverter"/>

        <!-- 底色色块模板选择器 -->
        <Style x:Key="ColorSwatchStyle" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="ToolTip" Value="{Binding DisplayText}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
            <RowDefinition Height="Auto"/>  <!-- 错误提示条 -->
            <RowDefinition Height="*"/>      <!-- 主内容区 -->
            <RowDefinition Height="Auto"/>  <!-- 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="选择图片" Command="{Binding SelectFileCommand}"
                        Width="100" Height="32" Margin="8,0" FontSize="13"
                        ToolTip="打开文件选择对话框，选择要换底的证件照原图"/>

                <Button Grid.Column="2" Content="开始处理" Command="{Binding StartProcessCommand}"
                        Width="100" Height="32" Margin="0,0,8,0" FontSize="13"
                        ToolTip="对已选图片执行证件照换底色处理">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#1976D2"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="4" Content="导出结果" Command="{Binding ExportResultCommand}"
                        Width="90" Height="32" Margin="4,0" FontSize="13"
                        ToolTip="将选中的处理结果保存到指定位置"/>
                <Button Grid.Column="5" Content="取消" Command="{Binding CancelCommand}"
                        Width="60" Height="32" Margin="4,0" FontSize="13"
                        ToolTip="取消当前正在执行的处理"/>
                <Button Grid.Column="6" Content="清除" Command="{Binding ClearResultsCommand}"
                        Width="60" Height="32" Margin="4,0" FontSize="13"
                        ToolTip="清除所有处理结果"/>
            </Grid>
        </Border>

        <!-- ===== 错误提示条 ===== -->
        <Border Grid.Row="1" Background="#FFEBEE" Padding="8"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="✕" Width="30" Height="24"
                        Command="{Binding ClearResultsCommand}" FontSize="14"
                        Background="Transparent" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- ===== 主内容区：左-输入配置 | 右-结果预览 ===== -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280"/>  <!-- 左侧：输入和配置 -->
                <ColumnDefinition Width="Auto"/>                <!-- 分隔线 -->
                <ColumnDefinition Width="*" MinWidth="400"/>     <!-- 右侧：结果预览和历史 -->
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧：输入区域和配置面板 ===== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 输入文件区域 -->
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="输入图片" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <!-- 拖拽区域 -->
                            <Border Height="100" BorderBrush="#BDBDBD" BorderThickness="2"
                                    CornerRadius="4" Background="#F5F5F5"
                                    AllowDrop="True"
                                    ToolTip="将图片拖拽到此处或点击下方按钮选择">
                                <Grid>
                                    <!-- 有文件时显示文件名 -->
                                    <TextBlock Text="{Binding InputFileName}"
                                               FontSize="13" Foreground="#1565C0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasInputFile}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 无文件时显示提示 -->
                                    <TextBlock Text="拖拽图片到此处，或点击「选择图片」按钮"
                                               FontSize="13" Foreground="Gray"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasInputFile}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 证件照规格选择 -->
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="证件照规格" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <ComboBox ItemsSource="{Binding AvailableSpecs}"
                                      SelectedItem="{Binding SelectedSpec}"
                                      DisplayMemberPath="DisplayText"
                                      Height="32" FontSize="13"
                                      ToolTip="选择目标证件照规格（1寸、2寸等）">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedSpec}" Value="False">
                                                <Setter Property="Text" Value="请选择规格"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <!-- 选中规格的详情 -->
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="Gray"
                                       Visibility="{Binding HasSelectedSpec, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="尺寸: "/>
                                <Run Text="{Binding SelectedSpec.SizeMmText, Mode=OneWay}"/>
                                <Run Text="  |  "/>
                                <Run Text="{Binding SelectedSpec.SizePxText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 底色选择 -->
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="目标底色" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <!-- 底色色块网格 -->
                            <ListBox ItemsSource="{Binding AvailableBackgroundColors}"
                                     SelectedItem="{Binding SelectedBackgroundColor}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ColorSwatchStyle}"
                                                Background="{Binding Converter={StaticResource ColorItemToBrushConverter}}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Border" Padding="0" Margin="2"
                                                            CornerRadius="4" BorderThickness="2"
                                                            BorderBrush="Transparent" Cursor="Hand"
                                                            ToolTip="{Binding DisplayText}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Border" Property="BorderBrush" Value="#1976D2"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="BorderBrush" Value="#90CAF9"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- 选中底色详情 -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding HasSelectedBackground, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Rectangle Width="20" Height="20" RadiusX="2" RadiusY="2"
                                           Fill="{Binding BackgroundColorPreview}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedBackgroundText}" FontSize="12"
                                           VerticalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 处理选项 -->
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="处理选项" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <!-- DPI 设置 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="DPI:" VerticalAlignment="Center" FontSize="13" Width="60"/>
                                <TextBox Text="{Binding Dpi, UpdateSourceTrigger=PropertyChanged}"
                                         Width="70" Height="26" FontSize="13"
                                         ToolTip="输出分辨率 (72-600)，默认 300"/>
                            </StackPanel>

                            <!-- 自动检测背景色 -->
                            <CheckBox IsChecked="{Binding AutoDetectBackground}"
                                      Margin="0,4" FontSize="13"
                                      ToolTip="自动分析原图背景色并生成人物遮罩">
                                <TextBlock Text="自动检测原图背景色" FontSize="13"/>
                            </CheckBox>

                            <!-- 边缘羽化 -->
                            <CheckBox IsChecked="{Binding EdgeFeather}"
                                      Margin="0,2" FontSize="13"
                                      ToolTip="对人物边缘进行羽化处理，避免生硬过渡">
                                <TextBlock Text="边缘羽化（更自然的过渡效果）" FontSize="13"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- ===== 右侧：结果预览和历史列表 ===== -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>      <!-- 上半部分：预览 -->
                    <RowDefinition Height="Auto"/>   <!-- 分隔 -->
                    <RowDefinition Height="160"/>     <!-- 下半部分：结果历史列表 -->
                </Grid.RowDefinitions>

                <!-- 结果预览区 -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 预览标题 -->
                        <Border Grid.Row="0" Padding="8,6"
                                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="结果预览"/>
                        </Border>

                        <!-- 无结果时的提示 -->
                        <TextBlock Grid.Row="1" FontSize="14" Foreground="Gray"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="选择图片、规格和底色后，点击「开始处理」查看结果">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedResult}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 有结果时显示详情 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSelectedResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="12">
                                <!-- 成功/失败标记 -->
                                <Border Padding="8,4" CornerRadius="3" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedResult.IsSuccess}" Value="True">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedResult.IsSuccess}" Value="False">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedResult.IsSuccess}" Value="True">
                                                            <Setter Property="Text" Value="✓ 处理成功"/>
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedResult.IsSuccess}" Value="False">
                                                            <Setter Property="Text" Value="✕ 处理失败"/>
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 结果详情项 -->
                                <Border Padding="8,6" Margin="0,2" CornerRadius="3"
                                        Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="输入文件" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInputFileName}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>

                                <Border Padding="8,6" Margin="0,2" CornerRadius="3"
                                        Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="输出尺寸" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSizeSummary}" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <Border Padding="8,6" Margin="0,2" CornerRadius="3"
                                        Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="使用规格" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSpecSummary}" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <Border Padding="8,6" Margin="0,2" CornerRadius="3"
                                        Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="目标底色" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedBackgroundSummary}" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <Border Padding="8,6" Margin="0,2" CornerRadius="3"
                                        Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="遮罩方法" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedMaskMethod}" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- 输出路径 -->
                                <Border Padding="8,6" Margin="0,2" CornerRadius="3"
                                        Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="输出路径" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedResult.OutputPath}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedResult.OutputPath}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 结果历史列表标题 -->
                <Border Grid.Row="1" Padding="8,6,8,4" Margin="0,8,0,0">
                    <TextBlock FontSize="14" FontWeight="SemiBold">
                        <Run Text="处理历史 "/>
                        <Run Text="{Binding ResultCount, Mode=OneWay, StringFormat=({0})}" FontSize="12" Foreground="Gray"/>
                    </TextBlock>
                </Border>

                <!-- 结果历史列表 -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1" CornerRadius="4">
                    <ListBox ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:IdPhotoResult}">
                                <Border Padding="8,4" Margin="2" CornerRadius="3"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 文件名和详情 -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding InputPath}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock FontSize="11" Foreground="Gray"
                                                           Text="{Binding SpecSummary}"/>
                                                <TextBlock FontSize="11" Foreground="Gray" Margin="8,0,0,0"
                                                           Text="{Binding BackgroundSummary}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 尺寸信息 -->
                                        <TextBlock Grid.Column="1" FontSize="11" Foreground="Gray"
                                                   VerticalAlignment="Center" Margin="4,0"
                                                   Text="{Binding SizeSummary}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 底部状态栏 ===== -->
        <Border Grid.Row="3" Padding="8,4" Margin="0,8,0,0"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 进度条和统计 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="200" Height="12" Margin="0,0,8,0"
                                 Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock FontSize="12" VerticalAlignment="Center">
                        <Run Text="{Binding SuccessCount, Mode=OneWay}" Foreground="Green" FontWeight="SemiBold"/>
                        <Run Text=" 成功, "/>
                        <Run Text="{Binding FailedCount, Mode=OneWay}" Foreground="Red" FontWeight="SemiBold"/>
                        <Run Text=" 失败"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
