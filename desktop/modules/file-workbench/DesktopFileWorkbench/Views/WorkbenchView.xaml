<UserControl x:Class="TTTools.FileWorkbench.Views.WorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:TTTools.FileWorkbench.ViewModels"
             xmlns:views="clr-namespace:TTTools.FileWorkbench.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             AllowDrop="True">

    <UserControl.Resources>
        <!-- 文件列表项样式 -->
        <Style x:Key="FileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- 操作按钮样式 -->
        <Style x:Key="WorkbenchButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- 最近文件项样式 -->
        <Style x:Key="RecentFileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="250" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="3*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧面板：文件列表 + 操作按钮 + 最近文件 ===== -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="📂 文件工作台" FontSize="18"
                       FontWeight="Bold" Margin="0,0,0,8" />

            <!-- 工具栏按钮 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="📥 导入文件" Style="{StaticResource WorkbenchButton}"
                        Command="{Binding ImportFilesCommand}" />
                <Button Content="⬆ 全选" Style="{StaticResource WorkbenchButton}"
                        Command="{Binding SelectAllCommand}" />
                <Button Content="🔄 反选" Style="{StaticResource WorkbenchButton}"
                        Command="{Binding InvertSelectionCommand}" />
                <Button Content="🗑 移除选中" Style="{StaticResource WorkbenchButton}"
                        Command="{Binding RemoveSelectedCommand}" />
                <Button Content="✖ 清空" Style="{StaticResource WorkbenchButton}"
                        Command="{Binding ClearAllCommand}" />
            </StackPanel>

            <!-- 文件拖拽区域 -->
            <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="2"
                    CornerRadius="8" Background="#F8F8F8"
                    AllowDrop="True"
                    DragEnter="OnFileListDragEnter"
                    DragLeave="OnFileListDragLeave"
                    Drop="OnFileListDrop"
                    Name="DragDropZone"
                    MinHeight="120">
                <Grid>
                    <!-- 有文件时显示列表 -->
                    <ListBox ItemsSource="{Binding Files}"
                             Style="{StaticResource FileItemStyle}"
                             SelectedItem="{Binding PreviewFilePath, Mode=OneWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             x:Name="FileListBox"
                             SelectionMode="Extended"
                             MouseDoubleClick="OnFileItemDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 文件类型图标 -->
                                    <TextBlock Grid.Column="0" Text="{Binding FileTypeIcon}"
                                               FontSize="18" VerticalAlignment="Center"
                                               Margin="0,0,8,0" />

                                    <!-- 文件信息 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                   FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SizeDisplay}" FontSize="11"
                                                       Foreground="Gray" Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{Binding IsSupported,
                                                           Converter={x:Static views:WorkbenchView.IsSupportedToColorConverter}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 选中状态 -->
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 无文件时的占位提示 -->
                    <TextBlock x:Name="DropHint" Text="📁 拖拽文件到此处开始"
                               FontSize="16" Foreground="#AAAAAA"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 文件统计 -->
            <TextBlock Grid.Row="3" Margin="0,4,0,4" FontSize="12" Foreground="#666666">
                <Run Text="共 " /><Run Text="{Binding FileCount}" FontWeight="Bold" />
                <Run Text=" 个文件，已选 " /><Run Text="{Binding SelectedCount}" FontWeight="Bold" /><Run Text=" 个" />
            </TextBlock>

            <!-- 最近文件区域标题 -->
            <Grid Grid.Row="4" Margin="0,8,0,4">
                <TextBlock Text="🕐 最近文件" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Content="清除" HorizontalAlignment="Right" Padding="8,4"
                        Command="{Binding ClearRecentCommand}" FontSize="12" />
            </Grid>

            <!-- 最近文件列表 -->
            <ListBox Grid.Row="5" ItemsSource="{Binding RecentFiles}"
                     Style="{StaticResource RecentFileItemStyle}"
                     BorderThickness="1" BorderBrush="#DDDDDD"
                     Background="White"
                     MinHeight="80" MaxHeight="200"
                     MouseDoubleClick="OnRecentFileDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="14" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" FontSize="12" />
                                <TextBlock Text="{Binding LastAccessedDisplay}"
                                           FontSize="10" Foreground="Gray" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ===== 分隔线 ===== -->
        <GridSplitter Grid.Column="1" Width="3"
                      HorizontalAlignment="Stretch"
                      Background="#DDDDDD" />

        <!-- ===== 右侧面板：文件预览 ===== -->
        <Grid Grid.Column="2" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 预览标题 -->
            <TextBlock Grid.Row="0" Text="👁 文件预览" FontSize="16"
                       FontWeight="SemiBold" Margin="0,0,0,8" />

            <!-- 预览区域 -->
            <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="4" Background="#FAFAFA">
                <Grid>
                    <!-- 有预览文件时显示内容 -->
                    <Grid x:Name="PreviewContentPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 预览文件名 -->
                        <Border Grid.Row="0" Background="#EEEEEE" Padding="8,4">
                            <TextBlock Text="{Binding PreviewFileName}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <!-- 图片预览 -->
                        <Image Grid.Row="1"
                               Source="{Binding PreviewFilePath}"
                               Stretch="Uniform"
                               Margin="8"
                               x:Name="PreviewImage" />

                        <!-- 非图片预览提示 -->
                        <TextBlock Grid.Row="1"
                                   x:Name="NonImagePreviewHint"
                                   Text="此文件类型暂不支持直接预览"
                                   Foreground="#999999" FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>

                    <!-- 无预览时的占位提示 -->
                    <TextBlock x:Name="PreviewPlaceholder"
                               Text="选择左侧文件列表中的文件进行预览"
                               FontSize="14" Foreground="#AAAAAA"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
