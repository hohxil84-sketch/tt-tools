<UserControl x:Class="TTTools.PreflightCheck.Views.PreflightCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TTTools.PreflightCheck.ViewModels"
             xmlns:models="clr-namespace:TTTools.PreflightCheck.Models"
             xmlns:local="clr-namespace:TTTools.PreflightCheck.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <UserControl.Resources>
        <!-- BooleanToVisibility 转换器 -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 风险等级颜色 -->
        <SolidColorBrush x:Key="PassBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#E65100"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#C62828"/>

        <!-- 风险等级背景色 -->
        <SolidColorBrush x:Key="PassBgBrush" Color="#E8F5E9"/>
        <SolidColorBrush x:Key="WarningBgBrush" Color="#FFF3E0"/>
        <SolidColorBrush x:Key="ErrorBgBrush" Color="#FFEBEE"/>

        <!-- 风险等级到图标转换器 -->
        <local:RiskToIconConverter x:Key="RiskToIconConverter"/>
        <!-- 风险等级到前景色转换器 -->
        <local:RiskToForegroundConverter x:Key="RiskToForegroundConverter"/>
        <!-- 风险等级到背景色转换器 -->
        <local:RiskToBackgroundConverter x:Key="RiskToBackgroundConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
            <RowDefinition Height="Auto"/>  <!-- 错误提示条 -->
            <RowDefinition Height="*"/>      <!-- 主内容区 -->
            <RowDefinition Height="Auto"/>  <!-- 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 服务状态指示 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceAvailable}" Value="True">
                                        <Setter Property="Fill" Value="Green"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ServiceStatusText}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <Button Grid.Column="1" Content="选择文件" Command="{Binding SelectFilesCommand}"
                        Width="100" Height="32" Margin="8,0" FontSize="13"
                        ToolTip="打开文件选择对话框，选择要检查的图像文件"/>
                <Button Grid.Column="2" Content="开始检查" Command="{Binding StartCheckCommand}"
                        Width="100" Height="32" Margin="0,0,8,0" FontSize="13"
                        ToolTip="对已选择的图像文件执行印前检查"/>

                <!-- 说明文字 -->
                <TextBlock Grid.Column="3" Text="支持拖放图像文件到本区域进行印前检查" VerticalAlignment="Center"
                           FontSize="12" Foreground="Gray" Margin="16,0"/>

                <Button Grid.Column="4" Content="复制报告" Command="{Binding CopyReportCommand}"
                        Width="90" Height="32" Margin="4,0" FontSize="13"
                        ToolTip="复制选中检查报告的文本到剪贴板"/>
                <Button Grid.Column="5" Content="清除报告" Command="{Binding ClearReportsCommand}"
                        Width="90" Height="32" Margin="4,0" FontSize="13"
                        ToolTip="清除所有印前检查报告"/>
            </Grid>
        </Border>

        <!-- ===== 错误提示条 ===== -->
        <Border Grid.Row="1" Background="#FFEBEE" Padding="8"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="✕" Width="30" Height="24"
                        Command="{Binding ClearReportsCommand}" FontSize="14"
                        Background="Transparent" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- ===== 主内容区：左右分栏 ===== -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>  <!-- 报告列表 -->
                <ColumnDefinition Width="Auto"/>                 <!-- 分隔线 -->
                <ColumnDefinition Width="*" MinWidth="300"/>     <!-- 详情检查项 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧：报告列表 -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 报告列表标题 -->
                    <Border Grid.Row="0" Padding="8,6"
                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="检查报告"/>
                            <TextBlock FontSize="12" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Run Text="共 "/>
                                <Run Text="{Binding ReportCount, Mode=OneWay}"/>
                                <Run Text=" 份"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 报告列表 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Reports}"
                             SelectedItem="{Binding SelectedReport}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PreflightCheckReport}">
                                <Border Padding="8,6" Margin="2" CornerRadius="3"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 文件名和总体评估 -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding OverallRiskDisplay}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FilePath}">
                                                <Run Text="{Binding FileName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- 图像信息 -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock FontSize="11" Foreground="Gray">
                                                <Run Text="尺寸: "/>
                                                <Run Text="{Binding ImageSizeDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="Gray" Margin="10,0,0,0">
                                                <Run Text="DPI: "/>
                                                <Run Text="{Binding DpiDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- 风险统计条形 -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock FontSize="11" Foreground="{StaticResource ErrorBrush}">
                                                <Run Text="❌ "/><Run Text="{Binding ErrorCount, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0">
                                                <Run Text="⚠️ "/><Run Text="{Binding WarningCount, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{StaticResource PassBrush}" Margin="8,0,0,0">
                                                <Run Text="✅ "/><Run Text="{Binding PassCount, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- 右侧：检查详情 -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="4" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 详情标题 -->
                    <Border Grid.Row="0" Padding="8,6"
                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="检查详情" Margin="0,0,8,0"/>
                            <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center"
                                       Text="{Binding SelectedReport.OverallRiskDisplay, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>

                    <!-- 图像基本信息 -->
                    <Border Grid.Row="1" Padding="8,4" Margin="8,4"
                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            CornerRadius="3">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" Foreground="Gray" Margin="0,0,12,0"
                                           Text="{Binding SelectedReport.FileName, StringFormat='文件: {0}', TargetNullValue='文件: -'}"/>
                                <TextBlock FontSize="12" Foreground="Gray" Margin="0,0,12,0"
                                           Text="{Binding SelectedReport.FileFormat, StringFormat='格式: {0}', TargetNullValue='格式: -'}"/>
                                <TextBlock FontSize="12" Foreground="Gray"
                                           Text="{Binding SelectedReport.FileSizeDisplay, StringFormat='大小: {0}', TargetNullValue='大小: -'}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock FontSize="12" Foreground="Gray" Margin="0,0,12,0"
                                           Text="{Binding SelectedReport.ImageSizeDisplay, StringFormat='图像尺寸: {0}', TargetNullValue='图像尺寸: -'}"/>
                                <TextBlock FontSize="12" Foreground="Gray" Margin="0,0,12,0"
                                           Text="{Binding SelectedReport.DpiDisplay, StringFormat='DPI: {0}', TargetNullValue='DPI: -'}"/>
                                <TextBlock FontSize="12" Foreground="Gray" Margin="0,0,12,0"
                                           Text="{Binding SelectedReport.ColorModeDisplay, StringFormat='颜色模式: {0}', TargetNullValue='颜色模式: -'}"/>
                                <TextBlock FontSize="12" Foreground="Gray"
                                           Text="{Binding SelectedReport.HasTransparency, StringFormat='透明通道: {0}', TargetNullValue='透明通道: -'}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 综合建议 -->
                    <Border Grid.Row="2" Padding="8,6" Margin="8,0"
                            Background="{Binding SelectedReport.OverallRisk, Converter={StaticResource RiskToBackgroundConverter}}"
                            CornerRadius="3"
                            Visibility="{Binding HasSelectedReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding SelectedReport.OverallMessage, Mode=OneWay}"
                                   FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Border>

                    <!-- 检查项列表 -->
                    <Border Grid.Row="3" Margin="8,8,8,8">
                        <Grid>
                            <!-- 无选中报告时的提示 -->
                            <TextBlock FontSize="14" Foreground="Gray" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Text="选择左侧报告查看详细检查结果">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedReport}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 检查项详细列表 -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedReport.Checks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:PreflightCheckResultItem}">
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="4"
                                                    Background="{Binding RiskLevel, Converter={StaticResource RiskToBackgroundConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 风险等级指示器和检查项名称 -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="110">
                                                        <TextBlock Text="{Binding RiskIcon}" FontSize="16"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding ItemDisplayName}" FontSize="13"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding RiskLevel, Converter={StaticResource RiskToForegroundConverter}}"/>
                                                    </StackPanel>

                                                    <!-- 检查结果消息 -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                               FontSize="13" TextWrapping="Wrap"
                                                               VerticalAlignment="Center" Margin="12,0,0,0"/>

                                                    <!-- 风险等级标签 -->
                                                    <Border Grid.Column="2" Padding="6,2" Margin="8,0,0,0" CornerRadius="2"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPass}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource PassBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding RiskLevelDisplay}" FontSize="11"
                                                                   Foreground="White" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底部状态栏 ===== -->
        <Border Grid.Row="3" Padding="8,4" Margin="0,8,0,0"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 进度条（运行中时显示） + 统计 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="200" Height="12" Margin="0,0,8,0"
                                 Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock FontSize="12" VerticalAlignment="Center">
                        <Run Text="{Binding PassCount, Mode=OneWay}" Foreground="{StaticResource PassBrush}" FontWeight="SemiBold"/>
                        <Run Text=" 通过, "/>
                        <Run Text="{Binding WarningCount, Mode=OneWay}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                        <Run Text=" 警告, "/>
                        <Run Text="{Binding ErrorCount, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold"/>
                        <Run Text=" 错误"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
