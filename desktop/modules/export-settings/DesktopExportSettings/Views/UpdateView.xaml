<UserControl x:Class="TTTools.ExportSettings.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TTTools.ExportSettings.ViewModels"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:UpdateViewModel />
    </UserControl.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题 ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="版本更新"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="查看当前版本和更新信息"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ==================== 内容区 ==================== -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <!-- 当前版本卡片 -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    MinWidth="360">
                <StackPanel HorizontalAlignment="Center">
                    <!-- 应用图标占位 -->
                    <TextBlock Text="🖨️"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />

                    <TextBlock Text="TT Tools"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <TextBlock Text="{Binding UpdateInfo.CurrentVersion, StringFormat='当前版本 v{0}'}"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,8,0,16" />

                    <!-- 分隔线 -->
                    <Border Height="1"
                            Background="{DynamicResource DividerBrush}"
                            Margin="0,0,0,16" />

                    <!-- 更新状态 -->
                    <TextBlock Text="{Binding UpdateInfo.CheckStatusText}"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />

                    <TextBlock Text="{Binding UpdateInfo.LastCheckTimeFormatted, StringFormat='最近检查：{0}'}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,16" />

                    <!-- 检查更新按钮 -->
                    <Button Content="检查更新"
                            Command="{Binding CheckUpdateCommand}"
                            Height="40"
                            Width="200"
                            FontSize="14"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsNotChecking}" />

                    <!-- 检查中提示 -->
                    <TextBlock Text="正在检查..."
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource WarningBrush}"
                               Margin="0,8,0,0"
                               Visibility="{Binding IsChecking, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- 更新操作按钮 -->
            <StackPanel HorizontalAlignment="Center"
                        Visibility="{Binding UpdateInfo.UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Content="📥  下载最新版本"
                        Command="{Binding OpenDownloadCommand}"
                        Height="40"
                        Width="200"
                        FontSize="14"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Margin="0,0,0,8" />

                <Button Content="📋  查看发布说明"
                        Command="{Binding OpenReleaseNotesCommand}"
                        Height="32"
                        Width="200"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}" />
            </StackPanel>

            <!-- 状态消息 -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,16,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
