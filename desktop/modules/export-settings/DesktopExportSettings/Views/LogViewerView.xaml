<UserControl x:Class="TTTools.ExportSettings.Views.LogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TTTools.ExportSettings.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:LogViewerViewModel />
    </UserControl.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题 ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="日志查看器"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="查看应用运行日志，排查问题"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ==================== 过滤栏 ==================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 级别过滤 -->
                <TextBlock Grid.Column="0"
                           Text="级别："
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"
                           FontSize="12" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding LevelFilters}"
                          SelectedIndex="{Binding SelectedLevelFilterIndex}"
                          DisplayMemberPath="Label"
                          Width="100"
                          Height="28"
                          Margin="0,0,12,0" />

                <!-- 搜索框 -->
                <TextBox Grid.Column="2"
                         x:Name="SearchBox"
                         Height="28"
                         Margin="0,0,8,0" />
                <Button Grid.Column="3"
                        Content="搜索"
                        Height="28"
                        Width="60"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Command="{Binding SearchCommand}"
                        CommandParameter="{Binding Text, ElementName=SearchBox}" />

                <!-- 刷新 -->
                <Button Grid.Column="4"
                        Content="🔄  刷新"
                        Height="28"
                        Width="70"
                        FontSize="12"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <!-- ==================== 日志列表 ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4">
            <ListBox ItemsSource="{Binding LogEntries}"
                     SelectedItem="{Binding SelectedEntry}"
                     Background="{DynamicResource BackgroundBrush}"
                     BorderThickness="0"
                     VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,4"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 时间戳 -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding TimestampFormatted}"
                                           FontSize="11"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />

                                <!-- 级别标签 -->
                                <Border Grid.Row="0" Grid.Column="1"
                                        CornerRadius="2"
                                        Padding="4,1"
                                        Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Background" Value="#DC3545" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Fatal">
                                                    <Setter Property="Background" Value="#721C24" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter Property="Background" Value="#FFC107" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Info">
                                                    <Setter Property="Background" Value="#17A2B8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LevelText}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="White" />
                                </Border>

                                <!-- 类别 -->
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{Binding Category, StringFormat=[{0}]}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                <!-- 消息 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                           Text="{Binding Message}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ==================== 底部状态栏 ==================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="显示 " />
                    <Run Text="{Binding DisplayCount}" FontWeight="SemiBold" />
                    <Run Text=" 条 | 日志目录：" />
                    <Run Text="{Binding TotalSizeText}" FontWeight="SemiBold" />
                </TextBlock>

                <Button Grid.Column="2"
                        Content="导出日志"
                        Height="28"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Command="{Binding ExportLogsCommand}" />

                <Button Grid.Column="3"
                        Content="清除日志"
                        Height="28"
                        FontSize="12"
                        Background="{DynamicResource ErrorBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="12,4"
                        Command="{Binding ClearLogsCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
