<UserControl x:Class="TTTools.ExportSettings.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TTTools.ExportSettings.ViewModels"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.DataContext>
        <vm:ExportViewModel />
    </UserControl.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 标题栏 -->
            <RowDefinition Height="Auto" />
            <!-- 内容区 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题 ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="导出文件"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="选择要导出的文件，配置导出选项"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ==================== 内容区 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左侧：文件列表和操作 -->
                <ColumnDefinition Width="*" />
                <!-- 右侧：导出配置 -->
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：文件列表 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 文件操作按钮 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="AddFilesButton"
                                Content="📂  添加文件"
                                Click="OnAddFilesClick"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0" />
                        <Button Content="🗑  清空"
                                Command="{Binding ClearFilesCommand}"
                                Background="{DynamicResource ErrorBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="12,6" />
                    </StackPanel>

                    <!-- 文件列表 -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SourceFiles}"
                             Background="{DynamicResource BackgroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Width="24" Height="24"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 进度和结果 -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <!-- 进度条 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0"
                                         Value="{Binding Progress}"
                                         Height="6"
                                         Minimum="0" Maximum="100" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProgressText}"
                                       Margin="12,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <!-- 结果摘要 -->
                        <TextBlock Text="{Binding ResultSummary}"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧：导出配置 -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="导出配置"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />

                    <!-- 导出格式 -->
                    <TextBlock Text="导出格式"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding FormatLabels}"
                              SelectedIndex="{Binding SelectedFormatIndex}"
                              Height="32"
                              Margin="0,0,0,12" />

                    <!-- 输出目录 -->
                    <TextBlock Text="输出目录"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Config.OutputDirectory}"
                                 Height="32"
                                 IsReadOnly="True" />
                        <Button Grid.Column="1"
                                x:Name="SelectOutputDirButton"
                                Content="..."
                                Width="32" Height="32"
                                Margin="4,0,0,0"
                                Click="OnSelectOutputDirClick" />
                    </Grid>

                    <!-- JPEG 质量 -->
                    <TextBlock Text="JPEG 质量"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <Slider Minimum="1" Maximum="100"
                            Value="{Binding Config.JpegQuality}"
                            Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Config.JpegQuality, StringFormat={}{0}%}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- 导出 DPI -->
                    <TextBlock Text="导出 DPI（0 = 保持原始）"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding Config.Dpi}"
                             Height="32"
                             Margin="0,0,0,12" />

                    <!-- 覆盖已有文件 -->
                    <CheckBox Content="覆盖已存在的文件"
                              IsChecked="{Binding Config.OverwriteExisting}"
                              Margin="0,0,0,8" />

                    <!-- 文件名前缀 -->
                    <TextBlock Text="文件名前缀（可选）"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding Config.FileNamePrefix}"
                             Height="32"
                             Margin="0,0,0,16" />

                    <!-- 导出按钮 -->
                    <Button Content="🚀  开始导出"
                            Command="{Binding StartExportCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="40"
                            FontSize="14" />
                    <Button Content="取消导出"
                            Command="{Binding CancelExportCommand}"
                            Margin="0,8,0,0"
                            Height="32"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
