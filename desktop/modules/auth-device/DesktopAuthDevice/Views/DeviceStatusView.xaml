<UserControl x:Class="TTTools.AuthDevice.Views.DeviceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TTTools.AuthDevice.Converters"
             MinWidth="360" MaxWidth="520"
             HorizontalAlignment="Center" VerticalAlignment="Top">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:LastCharsConverter x:Key="LastCharsConverter" />
    </UserControl.Resources>

    <!-- 设备绑定状态展示卡片 -->
    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="28,24"
            Margin="16">

        <StackPanel>
            <!-- 标题行 -->
            <TextBlock Text="设备绑定状态"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,20" />

            <!-- 加载指示器 -->
            <TextBlock Text="加载中..."
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                       Margin="0,0,0,16" />

            <!-- 错误提示 -->
            <Border Background="#FDE8E8"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C53030"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 状态指示器 -->
            <Border Margin="0,0,0,16"
                    Padding="12,10"
                    CornerRadius="8"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="active">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="blocked">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="removed">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="unknown">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="active">
                                        <Setter Property="Text" Value="✓" />
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="blocked">
                                        <Setter Property="Text" Value="✗" />
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="removed">
                                        <Setter Property="Text" Value="—" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="unknown">
                                        <Setter Property="Text" Value="?" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusDisplay}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 设备详情 -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <!-- 设备 ID（仅显示后 8 位 + 复制按钮） -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="设备 ID"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DeviceId, Converter={StaticResource LastCharsConverter}, ConverterParameter=8}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding DeviceId}" />
                        <Button Grid.Column="2"
                                x:Name="CopyDeviceIdButton"
                                Content="复制"
                                FontSize="11"
                                Height="26"
                                Padding="8,0"
                                Margin="8,0,0,0"
                                Cursor="Hand"
                                Click="OnCopyDeviceIdClick"
                                ToolTip="复制完整设备 ID">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background"
                                                                Value="{DynamicResource SurfaceBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- 设备名称 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="设备名称"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DeviceName}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>

                    <!-- 绑定时间 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="绑定时间"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BoundAt}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>

                    <!-- 最近活跃 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="最近活跃"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastSeenAt}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 刷新按钮 -->
            <Button Content="刷新设备状态"
                    FontSize="13"
                    Height="36"
                    Padding="16,0"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    Command="{Binding RefreshCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background"
                                                    Value="{DynamicResource SurfaceBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
