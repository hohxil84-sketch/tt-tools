<UserControl x:Class="TTTools.AuthDevice.Views.DeviceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TTTools.AuthDevice.Views"
             MinWidth="320" MaxWidth="480"
             HorizontalAlignment="Center" VerticalAlignment="Top">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <!-- 设备绑定状态展示卡片 -->
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="24"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                <TextBlock Text="设备绑定状态"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 加载指示器 -->
            <TextBlock Grid.Row="1"
                       Text="加载中..."
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

            <!-- 错误提示 -->
            <Border Grid.Row="1"
                    Background="#FDE8E8"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C53030"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 状态指示器 -->
            <Border Grid.Row="2"
                    Margin="0,0,0,16"
                    Padding="12,10"
                    CornerRadius="6"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="active">
                                <Setter Property="Background" Value="#E6FFFA" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="blocked">
                                <Setter Property="Background" Value="#FFF5F5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="removed">
                                <Setter Property="Background" Value="#F7FAFC" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="unknown">
                                <Setter Property="Background" Value="#F7FAFC" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="active">
                                        <Setter Property="Text" Value="✓" />
                                        <Setter Property="Foreground" Value="#38A169" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="blocked">
                                        <Setter Property="Text" Value="✗" />
                                        <Setter Property="Foreground" Value="#E53E3E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="removed">
                                        <Setter Property="Text" Value="—" />
                                        <Setter Property="Foreground" Value="#718096" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="unknown">
                                        <Setter Property="Text" Value="?" />
                                        <Setter Property="Foreground" Value="#718096" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusDisplay}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 设备详情 -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <!-- 设备 ID -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="设备 ID"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DeviceId}"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="Consolas"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- 设备名称 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="设备名称"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DeviceName}"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>

                <!-- 绑定时间 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="绑定时间"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding BoundAt}"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>

                <!-- 最近活跃 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="最近活跃"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding LastSeenAt}"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
            </StackPanel>

            <!-- 刷新按钮 -->
            <Button Grid.Row="4"
                    Content="刷新设备状态"
                    FontSize="13"
                    Height="36"
                    Padding="16,0"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    Command="{Binding RefreshCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#3182CE" />
                        <Setter Property="BorderBrush" Value="#3182CE" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EBF8FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
