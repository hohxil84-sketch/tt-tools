<UserControl x:Class="TTTools.AuthDevice.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TTTools.AuthDevice.Views"
             MinWidth="360" MaxWidth="420"
             HorizontalAlignment="Center" VerticalAlignment="Center">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToLoginTextConverter x:Key="BoolToLoginTextConverter" />
        <local:BoolInvertConverter x:Key="BoolInvertConverter" />
    </UserControl.Resources>

    <!-- 登录表单：账号、密码、登录按钮、错误提示 -->
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="32"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0"
                       Text="登录 TT Tools"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <!-- 错误提示区域 -->
            <Border Grid.Row="1"
                    Background="#FDE8E8"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C53030"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 账号输入 -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="账号"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="AccountBox"
                         Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="8,6"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         IsEnabled="{Binding IsLoggingIn, Converter={StaticResource BoolInvertConverter}}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>

            <!-- 密码输入 -->
            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <TextBlock Text="密码"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox"
                             FontSize="14"
                             Padding="8,6"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             IsEnabled="{Binding IsLoggingIn, Converter={StaticResource BoolInvertConverter}}">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>
            </StackPanel>

            <!-- 登录按钮 -->
            <Button Grid.Row="4"
                    Content="{Binding IsLoggingIn, Converter={StaticResource BoolToLoginTextConverter}}"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Height="42"
                    Margin="0,0,0,12"
                    IsEnabled="{Binding CanLogin}"
                    Cursor="Hand"
                    Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ElementName=PasswordBox}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#3182CE" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A0C4E8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2B6CB0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 底部提示 -->
            <TextBlock Grid.Row="5"
                       Text="登录后将自动绑定当前设备"
                       FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
