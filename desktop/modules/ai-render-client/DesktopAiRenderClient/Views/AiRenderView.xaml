<UserControl x:Class="TTTools.AiRenderClient.Views.AiRenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TTTools.AiRenderClient.Views"
             xmlns:vm="clr-namespace:TTTools.AiRenderClient.ViewModels"
             xmlns:dto="clr-namespace:TTShared.CloudApi.Dtos;assembly=TTShared"
             MinWidth="800" MinHeight="560">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:UrlToBitmapConverter x:Key="UrlToBitmapConverter" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 第1行：工具栏 ===== -->
        <Border Grid.Row="0" Padding="8,6" Margin="0,0,0,8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="🎨 创建任务" Width="110" Height="32"
                        Command="{Binding CreateTaskCommand}"
                        IsEnabled="{Binding CanCreateTask}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#7C3AED" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#C4B5FD" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1" Content="🔄 刷新状态" Width="100" Height="32"
                        Command="{Binding RefreshStatusCommand}"
                        IsEnabled="{Binding CanRefreshStatus}" Margin="0,0,8,0" />

                <Button Grid.Column="2" Content="清空" Width="60" Height="32"
                        Command="{Binding ClearCommand}" />

                <!-- 轮询状态指示器 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsPolling, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="⏳ 自动轮询中..." FontSize="11"
                               Foreground="#D69E2E" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 第2行：错误消息 ===== -->
        <Border Grid.Row="1" Background="#FDE8E8" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="#C53030"
                           FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" FontSize="12"
                        Background="Transparent" BorderThickness="0" Foreground="#C53030"
                        Click="OnDismissError" VerticalAlignment="Center" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- ===== 第3行：主内容区（左侧输入 + 右侧结果） ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧：输入表单 ===== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="效果图生成参数" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!-- 场景类型选择 -->
                        <TextBlock Text="场景类型" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{x:Static vm:AiRenderViewModel.SceneTypeList}"
                                  SelectedValue="{Binding SelectedScene}"
                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                  Height="30" Margin="0,0,0,8" />

                        <!-- 提示词 -->
                        <TextBlock Text="效果图描述 *" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                 Height="100" Margin="0,0,0,8" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="描述你期望的效果图画面，例如：一张现代风格的海报，以蓝色为主色调，突出科技感" />

                        <!-- 输入文件 ID（后续接入文件上传模块后启用） -->
                        <TextBlock Text="输入文件 ID（可选 · 暂未开放）" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding InputFileIdsText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="50" Margin="0,0,0,8" TextWrapping="Wrap" AcceptsReturn="True"
                                 IsEnabled="False"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="文件上传功能尚未开放，此处预留用于指定已上传到云端的参考文件 UUID。多个 ID 用逗号或换行分隔。" />

                        <!-- 风格选择 -->
                        <TextBlock Text="风格参考" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{x:Static vm:AiRenderViewModel.StyleList}"
                                  SelectedValue="{Binding SelectedStyle}"
                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                  Height="30" Margin="0,0,0,8" />

                        <!-- 输出尺寸 -->
                        <TextBlock Text="输出尺寸" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{x:Static vm:AiRenderViewModel.SizeList}"
                                  SelectedValue="{Binding SelectedSize}"
                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                  Height="30" Margin="0,0,0,8" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- ===== 右侧：结果展示 + 历史 ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="220" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>

                <!-- 结果展示区 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="任务状态" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!-- 任务信息条 -->
                        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="4"
                                Padding="8,6" Margin="0,0,0,8"
                                Visibility="{Binding HasTaskResult, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <!-- 任务 ID 和状态 -->
                                <WrapPanel Margin="0,0,0,4">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0">
                                        <Run Text="任务 ID: " /><Run Text="{Binding CurrentTaskId, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="状态: " />
                                        <Run Text="{Binding TaskStatusDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </WrapPanel>

                                <!-- 任务进行中动画 -->
                                <TextBlock FontSize="11" Foreground="#D69E2E"
                                           Visibility="{Binding IsTaskRunning, Converter={StaticResource BoolToVisibility}}"
                                           Text="⏳ 云端正在处理，请等待..." Margin="0,2,0,0" />

                                <!-- 任务失败提示 -->
                                <TextBlock FontSize="11" Foreground="#E53E3E"
                                           Visibility="{Binding IsTaskFailed, Converter={StaticResource BoolToVisibility}}"
                                           Text="任务处理失败，请重试或联系管理员" Margin="0,2,0,0" />

                                <!-- Provider / 模型 / 扣费信息（任务完成后展示） -->
                                <WrapPanel Margin="0,4,0,0"
                                           Visibility="{Binding IsTaskCompleted, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0">
                                        <Run Text="Provider: " /><Run Text="{Binding Provider, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0">
                                        <Run Text="模型: " /><Run Text="{Binding Model, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0">
                                        <Run Text="扣费: " />
                                        <Run Text="{Binding CreditsCharged, Mode=OneWay}" FontWeight="SemiBold" Foreground="#E53E3E" />
                                        <Run Text=" 额度" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="估算成本: $" />
                                        <Run Text="{Binding EstimatedCost, StringFormat=F4, Mode=OneWay}" />
                                    </TextBlock>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 结果文件缩略图列表 -->
                        <Border Grid.Row="2" Margin="0,0,0,8"
                                Visibility="{Binding IsTaskCompleted, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <!-- 标题行 + 打开目录按钮 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="生成结果" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Width="Auto" Height="26"
                                            Padding="8,0" FontSize="11"
                                            Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" Cursor="Hand"
                                            Command="{Binding DataContext.OpenOutputFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="在资源管理器中打开图片保存目录">
                                        <TextBlock Text="📁 打开目录" />
                                    </Button>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding ResultFiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="144" Margin="0,0,6,6"
                                                    Background="{DynamicResource BackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="4">
                                                <StackPanel>
                                                    <!-- 缩略图区域（点击查看大图） -->
                                                    <Border Height="130" Margin="2,2,2,0"
                                                            Background="Transparent" Cursor="Hand"
                                                            MouseLeftButtonDown="OnResultFileClick"
                                                            ToolTip="点击查看大图">
                                                        <Image Source="{Binding Url, Converter={StaticResource UrlToBitmapConverter}, IsAsync=True}"
                                                               Stretch="UniformToFill" />
                                                    </Border>

                                                    <!-- 底部信息栏：尺寸 + 保存按钮 -->
                                                    <Grid Margin="3,3,3,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontSize="9"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="{Binding Width, Mode=OneWay, StringFormat='{}{0}×'}" />
                                                            <Run Text="{Binding Height, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <Button Grid.Column="1" Width="26" Height="22"
                                                                FontSize="11" Padding="0"
                                                                Background="Transparent" BorderThickness="0"
                                                                Cursor="Hand" ToolTip="另存为..."
                                                                Command="{Binding DataContext.SaveResultFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="💾" />
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 无结果时的提示 -->
                        <TextBlock Grid.Row="3" Text="填写左侧参数，点击「创建任务」按钮提交云端效果图生成任务"
                                   FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTaskResult}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 历史记录区 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="任务历史 (" /><Run Text="{Binding HistoryCount, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>

                        <ListBox Grid.Row="1" ItemsSource="{Binding HistoryItems}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,5" Margin="0,0,0,2" CornerRadius="4"
                                            Background="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="OnHistoryItemClick">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding TimeDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Width="70" />
                                                <TextBlock Text="{Binding SceneTypeDisplay}" FontSize="11"
                                                           Foreground="#7C3AED" Width="80" />
                                                <Border Background="{Binding StatusColor}" CornerRadius="3"
                                                        Padding="4,1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                               Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding CostSummary}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding PromptSummary}" FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="70,2,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 第4行：状态栏 ===== -->
        <Border Grid.Row="3" Padding="8,4" Margin="0,6,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 加载指示器 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="⏳" FontSize="12" Margin="0,0,4,0" />
                    <TextBlock Text="正在提交..." FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="2" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="{Binding HasTaskResult, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="Provider Call ID: " />
                    <Run Text="{Binding ProviderCallId, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- ===== 大图预览弹窗（覆盖全部区域） ===== -->
        <Border Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="3"
                Background="#CC000000"
                Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                MouseLeftButtonDown="OnPreviewBackgroundClick"
                Cursor="Hand">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部操作栏 -->
                <Border Grid.Row="0" Background="#1A1A2E" CornerRadius="6,6,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="图片预览" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Width="32" Height="32"
                                FontSize="16" Background="#E53E3E" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Command="{Binding ClosePreviewCommand}"
                                Content="✕" />
                    </Grid>
                </Border>

                <!-- 大图 -->
                <Image Grid.Row="1"
                       Source="{Binding PreviewImageUrl, Converter={StaticResource UrlToBitmapConverter}, IsAsync=True}"
                       Stretch="Uniform" Margin="0"
                       MouseLeftButtonDown="OnPreviewImageClick" />

                <!-- 底部提示 -->
                <Border Grid.Row="2" Background="#1A1A2E" CornerRadius="0,0,6,6" Padding="12,6">
                    <TextBlock Text="点击图片或背景关闭预览" FontSize="11"
                               Foreground="#A0A0B0" HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
