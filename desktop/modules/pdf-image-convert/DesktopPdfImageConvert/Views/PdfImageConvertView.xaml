<UserControl x:Class="TTTools.PdfImageConvert.Views.PdfImageConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TTTools.PdfImageConvert.ViewModels"
             xmlns:local="clr-namespace:TTTools.PdfImageConvert.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PdfImageConvertViewModel}"
             AllowDrop="True"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             MinWidth="500" MinHeight="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToColorConverter x:Key="BoolToColorConverter" />
        <local:BoolToSuccessTextConverter x:Key="BoolToSuccessTextConverter" />
        <local:BoolToSuccessColorConverter x:Key="BoolToSuccessColorConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 第 1 行：标题和状态 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="PDF / 图片互转"
                       FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="13" Foreground="{Binding IsServiceAvailable, Converter={StaticResource BoolToColorConverter}}"/>
        </StackPanel>

        <!-- 第 2 行：转换方向 -->
        <GroupBox Grid.Row="1" Header="转换方向" Margin="0,0,0,8" Padding="10">
            <StackPanel>
                <ComboBox ItemsSource="{x:Static vm:PdfImageConvertViewModel.DirectionList}"
                          SelectedValue="{Binding SelectedDirection}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="Display"
                          Height="28"/>
                <TextBlock Text="{Binding ServiceStatusText}"
                           FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 第 3 行：PDF→图片参数（条件可见） -->
        <GroupBox Grid.Row="2" Header="输出参数" Margin="0,0,0,8" Padding="10"
                  Visibility="{Binding IsPdfToImages, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <!-- DPI -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="DPI (72-600):" Width="120" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Dpi, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Height="24"/>
                    <TextBlock Text="值越高越清晰，文件越大" FontSize="11" Foreground="Gray"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- 输出格式 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="输出格式:" Width="120" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{x:Static vm:PdfImageConvertViewModel.FormatList}"
                              SelectedValue="{Binding SelectedOutputFormat}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Display"
                              Width="120" Height="24"/>
                </StackPanel>

                <!-- JPEG 质量（条件可见） -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding ShowJpegQuality, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="JPEG 质量 (1-100):" Width="120" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding JpegQuality, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Height="24"/>
                </StackPanel>

                <!-- 页码范围（可选） -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="页码范围:" Width="120" VerticalAlignment="Center"/>
                    <TextBlock Text="从" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding PageStart, UpdateSourceTrigger=PropertyChanged}"
                             Width="50" Height="24"/>
                    <TextBlock Text="到" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <TextBox Text="{Binding PageEnd, UpdateSourceTrigger=PropertyChanged}"
                             Width="50" Height="24"/>
                    <TextBlock Text="(0=全部)" FontSize="11" Foreground="Gray"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- 页数限制 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="页数限制:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PageLimit, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Height="24"/>
                    <TextBlock Text="(0=不限制)" FontSize="11" Foreground="Gray"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 第 4 行：结果列表 -->
        <GroupBox Grid.Row="4" Header="{Binding Path=Results.Count, StringFormat='处理结果 ({0})'}"
                  Margin="0,0,0,8" Padding="4">
            <ListBox ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <StackPanel Orientation="Horizontal">
                                <!-- 成功/失败图标 -->
                                <TextBlock Text="{Binding IsSuccess, Converter={StaticResource BoolToSuccessTextConverter}}"
                                           Foreground="{Binding IsSuccess, Converter={StaticResource BoolToSuccessColorConverter}}"
                                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <!-- 文件名 -->
                                <TextBlock Text="{Binding InputFileName}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DirectionDisplay}" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding PagesSummary}" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- 第 5 行：底部按钮和进度条 -->
        <StackPanel Grid.Row="5">
            <!-- 进度条 -->
            <Grid Margin="0,0,0,8">
                <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}"
                             Value="{Binding ProgressValue}" Height="4"/>
            </Grid>

            <!-- 错误信息 -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red" FontSize="12"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                       Margin="0,0,0,8" TextWrapping="Wrap"/>

            <!-- 按钮栏 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="选择文件" Command="{Binding SelectFilesCommand}"
                        IsEnabled="{Binding CanStart}" Width="80" Height="28" Margin="0,0,8,0"/>
                <Button Content="取消" Command="{Binding CancelCommand}"
                        IsEnabled="{Binding CanCancel}" Width="60" Height="28" Margin="0,0,8,0"/>
                <Button Content="清除结果" Command="{Binding ClearResultsCommand}"
                        Width="80" Height="28" Margin="0,0,8,0"/>
                <Button Content="打开文件" Command="{Binding OpenOutputFileCommand}"
                        IsEnabled="{Binding HasSelectedResult}" Width="80" Height="28"/>
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>
