<UserControl x:Class="TTTools.AiImageToolsClient.Views.AiImageToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TTTools.AiImageToolsClient.Views"
             xmlns:vm="clr-namespace:TTTools.AiImageToolsClient.ViewModels"
             xmlns:dto="clr-namespace:TTShared.CloudApi.Dtos;assembly=TTShared"
             MinWidth="860" MinHeight="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 第1行：工具栏 ===== -->
        <Border Grid.Row="0" Padding="8,6" Margin="0,0,0,8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <WrapPanel>
                <!-- 功能选择 -->
                <TextBlock Text="功能：" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{x:Static vm:AiImageToolsViewModel.FeatureList}"
                          SelectedValue="{Binding SelectedFeature}"
                          DisplayMemberPath="Display" SelectedValuePath="Value"
                          Width="150" Height="28" Margin="0,0,12,0" />

                <!-- 操作按钮 -->
                <Button Content="📁 添加图片" Width="100" Height="28"
                        Command="{Binding AddFilesCommand}" Margin="0,0,6,0" />
                <Button Content="🚀 开始处理" Width="100" Height="28"
                        Command="{Binding StartProcessingCommand}"
                        IsEnabled="{Binding CanStartProcessing}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#7C3AED" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#C4B5FD" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="🔄 刷新状态" Width="100" Height="28"
                        Command="{Binding RefreshStatusCommand}"
                        IsEnabled="{Binding CanRefreshStatus}" Margin="0,0,6,0" />
                <Button Content="💰 查余额" Width="80" Height="28"
                        Command="{Binding RefreshBalanceCommand}" Margin="0,0,6,0" />
                <Button Content="清空" Width="60" Height="28"
                        Command="{Binding ClearCommand}" Margin="0,0,6,0" />

                <!-- 余额显示 -->
                <TextBlock Text="{Binding BalanceDisplay}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />

                <!-- 轮询指示器 -->
                <TextBlock Text="⏳ 自动轮询中..." FontSize="11"
                           Foreground="#D69E2E" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding IsPolling, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </Border>

        <!-- ===== 第2行：错误消息 ===== -->
        <Border Grid.Row="1" Background="#FDE8E8" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="#C53030"
                           FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" FontSize="12"
                        Background="Transparent" BorderThickness="0" Foreground="#C53030"
                        Click="OnDismissError" VerticalAlignment="Center" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- ===== 第3行：功能特定参数区 ===== -->
        <Border Grid.Row="2" Padding="8,6" Margin="0,0,0,8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <WrapPanel>
                <!-- AI 改图：Prompt 输入框（仅 ai_edit_image_cloud 显示） -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                            Visibility="{Binding IsEditFeature, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="编辑提示词 *：" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                    <TextBox Text="{Binding EditPrompt, UpdateSourceTrigger=PropertyChanged}"
                             Width="320" Height="26" VerticalContentAlignment="Center"
                             ToolTip="描述你想要的图片修改效果，例如：将背景改为蓝天白云，增加温暖色调" />
                </StackPanel>

                <!-- 转矢量：输出格式选择（仅 vectorize_image_cloud 显示） -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                            Visibility="{Binding IsVectorizeFeature, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="输出格式：" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{x:Static vm:AiImageToolsViewModel.VectorFormatList}"
                              SelectedValue="{Binding VectorOutputFormat}"
                              DisplayMemberPath="Display" SelectedValuePath="Value"
                              Width="180" Height="26" />
                </StackPanel>

                <!-- OCR：语言选择（仅 ocr_cloud 显示） -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                            Visibility="{Binding IsOcrFeature, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="识别语言：" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{x:Static vm:AiImageToolsViewModel.OcrLanguageList}"
                              SelectedValue="{Binding OcrLanguage}"
                              DisplayMemberPath="Display" SelectedValuePath="Value"
                              Width="140" Height="26" />
                </StackPanel>

                <!-- 高清修复：放大倍率选择（仅 upscale_image_cloud 显示） -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                            Visibility="{Binding IsUpscaleFeature, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="放大倍率：" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{x:Static vm:AiImageToolsViewModel.UpscaleFactorList}"
                              SelectedValue="{Binding UpscaleFactor}"
                              DisplayMemberPath="Display" SelectedValuePath="Value"
                              Width="120" Height="26" />
                </StackPanel>

                <!-- 高级抠图提示（仅 remove_bg_cloud 显示） -->
                <TextBlock Text="云端 AI 精准抠图，自动识别主体与背景"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="{Binding IsRemoveBgFeature, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </Border>

        <!-- ===== 第4行：主内容区 ===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧：待处理文件列表 ===== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="📋 待处理列表 (" />
                            <Run Text="{Binding PendingFileCount, Mode=OneWay}" />
                            <Run Text=")" />
                        </TextBlock>
                        <Button Content="清空列表" FontSize="11" Height="24" Width="70"
                                Command="{Binding ClearPendingCommand}" Margin="12,0,0,0"
                                Visibility="{Binding PendingFileCount, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- 文件列表 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding PendingFiles}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,5" Margin="0,0,0,2" CornerRadius="4"
                                        Background="{DynamicResource BackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FileName}" FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            <WrapPanel Margin="0,2,0,0">
                                                <TextBlock Text="{Binding FileSizeDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding AddedAtDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="✕" Width="22" Height="22" FontSize="10"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource TextTertiaryBrush}"
                                                Cursor="Hand" Click="OnRemoveFileClick"
                                                Tag="{Binding}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空列表提示 -->
                    <TextBlock Grid.Row="1" Text="点击「📁 添加图片」选择要处理的图片文件"
                               FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PendingFileCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PendingFileCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- ===== 右侧：任务状态 + 结果展示 ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="240" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="190" />
                </Grid.RowDefinitions>

                <!-- 结果展示区 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 任务标题 -->
                            <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="任务状态" />
                                <Run Text=" — " />
                                <Run Text="{Binding SelectedFeatureDisplay, Mode=OneWay}" Foreground="#7C3AED" />
                            </TextBlock>

                            <!-- 任务信息条 -->
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="4"
                                    Padding="8,6" Margin="0,0,0,8"
                                    Visibility="{Binding HasTaskResult, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,4">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,12,0">
                                            <Run Text="任务 ID: " />
                                            <Run Text="{Binding CurrentTaskId, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="状态: " />
                                            <Run Text="{Binding TaskStatusDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </WrapPanel>

                                    <!-- 排队/处理中提示 -->
                                    <TextBlock FontSize="11" Foreground="#D69E2E"
                                               Visibility="{Binding IsTaskRunning, Converter={StaticResource BoolToVisibility}}"
                                               Text="⏳ 云端正在处理，请等待..." Margin="0,2,0,0" />

                                    <!-- 失败提示 -->
                                    <TextBlock FontSize="11" Foreground="#E53E3E"
                                               Visibility="{Binding IsTaskFailed, Converter={StaticResource BoolToVisibility}}"
                                               Text="任务处理失败，请重试或联系管理员" Margin="0,2,0,0" />

                                    <!-- Provider / 模型 / 扣费（任务完成后） -->
                                    <WrapPanel Margin="0,4,0,0"
                                               Visibility="{Binding IsTaskCompleted, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,12,0">
                                            <Run Text="Provider: " />
                                            <Run Text="{Binding Provider, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,12,0">
                                            <Run Text="模型: " />
                                            <Run Text="{Binding Model, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,12,0">
                                            <Run Text="扣费: " />
                                            <Run Text="{Binding CreditsCharged, Mode=OneWay}" FontWeight="SemiBold"
                                                 Foreground="#E53E3E" />
                                            <Run Text=" 额度" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="估算成本: $" />
                                            <Run Text="{Binding EstimatedCost, StringFormat=F4, Mode=OneWay}" />
                                        </TextBlock>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- ===== 前后对比区域（高清修复 + 高级抠图） ===== -->
                            <Border Margin="0,0,0,8"
                                    Visibility="{Binding ShowBeforeAfter, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="前后对比" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 原图 -->
                                        <Border Grid.Column="0" Background="{DynamicResource BackgroundBrush}"
                                                CornerRadius="4" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="📷 原图" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding PendingFiles}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding FileName}" FontSize="11"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="→" FontSize="20" FontWeight="Bold"
                                                   Foreground="#7C3AED" VerticalAlignment="Center" Margin="12,0" />

                                        <!-- 结果 -->
                                        <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}"
                                                CornerRadius="4" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="✨ 结果" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#38A169" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding ResultFiles}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,4">
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           Text="{Binding FileId, StringFormat='文件: {0}'}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <WrapPanel>
                                                                    <TextBlock FontSize="10"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                                               Text="{Binding MimeType}" Margin="0,0,8,0" />
                                                                    <TextBlock FontSize="10"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}">
                                                                        <Run Text="{Binding Width, Mode=OneWay, StringFormat='{}{0}×'}" />
                                                                        <Run Text="{Binding Height, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ===== 结果文件列表（所有功能通用） ===== -->
                            <Border Margin="0,0,0,8"
                                    Visibility="{Binding IsTaskCompleted, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="📦 结果文件" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />

                                    <ItemsControl ItemsSource="{Binding ResultFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="4"
                                                        Padding="8,6" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 文件类型标签 -->
                                                        <Border Grid.Column="0" Background="#EDE9FE" CornerRadius="3"
                                                                Padding="4,2" Margin="0,0,8,0">
                                                            <TextBlock FontSize="10" Foreground="#6D28D9"
                                                                       Text="{Binding MimeType}" />
                                                        </Border>

                                                        <!-- 文件信息 -->
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Text="{Binding FileId, StringFormat='文件: {0}'}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}">
                                                                <Run Text="{Binding Width, Mode=OneWay, StringFormat='{}{0}×'}" />
                                                                <Run Text="{Binding Height, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- 操作按钮 -->
                                                        <Button Grid.Column="2" Content="🔗 打开" FontSize="10"
                                                                Width="52" Height="24"
                                                                Foreground="#7C3AED" Margin="0,0,4,0"
                                                                Click="OnResultFileClick" Tag="{Binding}" />
                                                        <Button Grid.Column="3" Content="⬇ 下载" FontSize="10"
                                                                Width="52" Height="24"
                                                                Foreground="#38A169"
                                                                Click="OnDownloadClick" Tag="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ===== OCR 结果文本区（保留排版） ===== -->
                            <Border Margin="0,0,0,8"
                                    Visibility="{Binding ShowOcrResult, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="📝 OCR 识别结果" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="4"
                                            Padding="10" MaxHeight="200">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding OcrResultText, Mode=OneWay}"
                                                     TextWrapping="Wrap" AcceptsReturn="True"
                                                     IsReadOnly="True" FontSize="13"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     FontFamily="Consolas, Microsoft YaHei"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 无结果时的提示 -->
                            <TextBlock Text="选择功能类型和图片文件，点击「🚀 开始处理」提交云端 AI 图片处理任务"
                                       FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,20,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTaskResult}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 历史记录区 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="📜 任务历史 (" />
                            <Run Text="{Binding HistoryCount, Mode=OneWay}" />
                            <Run Text=")" />
                        </TextBlock>

                        <ListBox Grid.Row="1" ItemsSource="{Binding HistoryItems}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,5" Margin="0,0,0,2" CornerRadius="4"
                                            Background="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="OnHistoryItemClick">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding TimeDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Width="60" />
                                                <TextBlock Text="{Binding FeatureDisplay}" FontSize="11"
                                                           Foreground="#7C3AED" Width="100" />
                                                <Border Background="{Binding StatusColor}" CornerRadius="3"
                                                        Padding="4,1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                               Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding CostSummary}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding InputFilesSummary}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="60,2,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 第5行：状态栏 ===== -->
        <Border Grid.Row="4" Padding="8,4" Margin="0,6,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 加载指示器 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="⏳" FontSize="12" Margin="0,0,4,0" />
                    <TextBlock Text="正在处理..." FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="2" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="{Binding HasTaskResult, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="Provider Call ID: " />
                    <Run Text="{Binding ProviderCallId, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
