<UserControl x:Class="TTTools.AiCopyClient.Views.AiCopyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TTTools.AiCopyClient.Views"
             xmlns:vm="clr-namespace:TTTools.AiCopyClient.ViewModels"
             MinWidth="780" MinHeight="540">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 第1行：工具栏 ===== -->
        <Border Grid.Row="0" Padding="8,6" Margin="0,0,0,8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="✨ 生成文案" Width="110" Height="32"
                        Command="{Binding GenerateCommand}"
                        IsEnabled="{Binding CanGenerate}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#7C3AED" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#C4B5FD" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1" Content="取消" Width="60" Height="32"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding CanCancel}" Margin="0,0,8,0" />

                <Button Grid.Column="3" Content="复制文案" Width="80" Height="32"
                        Command="{Binding CopyTextCommand}"
                        IsEnabled="{Binding HasGeneratedText}" Margin="0,0,8,0" />

                <Button Grid.Column="4" Content="清空" Width="60" Height="32"
                        Command="{Binding ClearCommand}" />
            </Grid>
        </Border>

        <!-- ===== 第2行：错误消息 ===== -->
        <Border Grid.Row="1" Background="#FDE8E8" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="#C53030"
                           FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" FontSize="12"
                        Background="Transparent" BorderThickness="0" Foreground="#C53030"
                        Click="OnDismissError" VerticalAlignment="Center" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- ===== 第3行：主内容区（左侧输入 + 右侧结果） ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧：输入表单 ===== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="文案生成参数" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!-- 场景选择 -->
                        <TextBlock Text="场景类型" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{x:Static vm:AiCopyViewModel.SceneList}"
                                  SelectedValue="{Binding SelectedScene}"
                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                  Height="30" Margin="0,0,0,8" />

                        <!-- 产品名称 -->
                        <TextBlock Text="产品 / 服务名称 *" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" Margin="0,0,0,8"
                                 ToolTip="例如：快印宣传单 / 企业画册 / 名片设计" />

                        <!-- 目标受众 -->
                        <TextBlock Text="目标受众" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding TargetAudience, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" Margin="0,0,0,8"
                                 ToolTip="例如：附近商户 / 年轻白领 / 学生群体" />

                        <!-- 卖点列表 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="核心卖点" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="添加" Width="52" Height="24" FontSize="11"
                                    Command="{Binding AddSellingPointCommand}"
                                    IsEnabled="{Binding CanAddSellingPoint}" />
                        </Grid>

                        <TextBox Text="{Binding NewSellingPoint, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28" Margin="0,0,0,4"
                                 ToolTip="输入一个卖点后点击「添加」，例如：当天取件 / 高清印刷 / 免费设计">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddSellingPointCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- 卖点标签列表 -->
                        <ItemsControl ItemsSource="{Binding SellingPoints}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#EDE9FE" CornerRadius="4" Padding="6,3" Margin="0,0,4,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#6D28D9"
                                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <Button Content="✕" Width="18" Height="18" FontSize="10"
                                                    Background="Transparent" BorderThickness="0" Foreground="#8B5CF6"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveSellingPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 语气 -->
                        <TextBlock Text="文案语气" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{x:Static vm:AiCopyViewModel.ToneList}"
                                  SelectedValue="{Binding SelectedTone}"
                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                  Height="30" Margin="0,0,0,8" />

                        <!-- 平台 -->
                        <TextBlock Text="发布平台" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{x:Static vm:AiCopyViewModel.PlatformList}"
                                  SelectedValue="{Binding SelectedPlatform}"
                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                  Height="30" Margin="0,0,0,8" />

                        <!-- 额外需求 -->
                        <TextBlock Text="额外需求" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding ExtraRequirements, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60" Margin="0,0,0,8" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="自由输入额外需求，例如：突出开业活动 / 强调环保材质" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- ===== 右侧：结果展示 + 历史 ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>

                <!-- 结果展示区 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="生成结果" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!-- Provider/Model/扣费信息 -->
                        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="4"
                                Padding="8,6" Margin="0,0,0,8"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0">
                                    <Run Text="Provider: " /><Run Text="{Binding Provider, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0">
                                    <Run Text="模型: " /><Run Text="{Binding Model, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0">
                                    <Run Text="扣费: " />
                                    <Run Text="{Binding CreditsCharged, Mode=OneWay}" FontWeight="SemiBold" Foreground="#E53E3E" />
                                    <Run Text=" 额度" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="估算成本: $" />
                                    <Run Text="{Binding EstimatedCost, StringFormat=F4, Mode=OneWay}" />
                                </TextBlock>
                            </WrapPanel>
                        </Border>

                        <!-- 主文案显示（可编辑 + 可复制） -->
                        <Border Grid.Row="2" Background="{DynamicResource BackgroundBrush}" CornerRadius="4"
                                Padding="4" Margin="0,0,0,8"
                                Visibility="{Binding HasGeneratedText, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Text="{Binding GeneratedText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
                                     Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Visible" MaxHeight="320"
                                     SpellCheck.IsEnabled="False" />
                        </Border>

                        <!-- 文案变体列表 -->
                        <Border Grid.Row="3"
                                Visibility="{Binding HasGeneratedText, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="文案变体" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />

                                <ItemsControl ItemsSource="{Binding Variants}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="4"
                                                    Padding="4,2" Margin="0,0,0,4" Cursor="Hand"
                                                    MouseLeftButtonDown="OnVariantClick">
                                                <TextBox Text="{Binding ., Mode=OneWay}" FontSize="12"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         Background="Transparent" BorderThickness="0"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         IsReadOnly="False"
                                                         SpellCheck.IsEnabled="False" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 无结果时的提示 -->
                        <TextBlock Grid.Row="2" Text="填写左侧参数，点击「生成文案」按钮调用云端 AI 生成广告文案"
                                   FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasGeneratedText, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGeneratedText}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 历史记录区 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="历史记录 (" /><Run Text="{Binding HistoryCount, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>

                        <ListBox Grid.Row="1" ItemsSource="{Binding HistoryItems}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,5" Margin="0,0,0,2" CornerRadius="4"
                                            Background="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="OnHistoryItemClick">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding TimeDisplay}" FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Width="70" />
                                                <TextBlock Text="{Binding SceneDisplay}" FontSize="11"
                                                           Foreground="#7C3AED" Width="100" />
                                                <TextBlock Text="{Binding CostSummary}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding TextSummary}" FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="70,2,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 第4行：状态栏 ===== -->
        <Border Grid.Row="3" Padding="8,4" Margin="0,6,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 加载指示器 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="⏳" FontSize="12" Margin="0,0,4,0" />
                    <TextBlock Text="正在生成..." FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="2" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="Provider Call ID: " />
                    <Run Text="{Binding ProviderCallId, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
