<UserControl x:Class="TTTools.RemoveBg.Views.RemoveBgView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TTTools.RemoveBg.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="950"
             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <UserControl.Resources>
        <!-- BooleanToVisibility 转换器 -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 反转 BooleanToVisibility -->
        <BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- 成功状态颜色 -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
        <!-- 错误状态颜色 -->
        <SolidColorBrush x:Key="ErrorBrush" Color="#C62828"/>
        <!-- 信息颜色 -->
        <SolidColorBrush x:Key="InfoBrush" Color="#1565C0"/>

        <!-- 快速背景色预设 -->
        <SolidColorBrush x:Key="WhitePresetBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="RedPresetBrush" Color="#FF0000"/>
        <SolidColorBrush x:Key="BluePresetBrush" Color="#0000FF"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
            <RowDefinition Height="Auto"/>  <!-- 错误提示条 -->
            <RowDefinition Height="*"/>      <!-- 主内容区 -->
            <RowDefinition Height="Auto"/>  <!-- 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 服务状态指示 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceAvailable}" Value="True">
                                        <Setter Property="Fill" Value="Green"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ServiceStatusText}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <Button Grid.Column="1" Content="选择图片" Command="{Binding SelectFilesCommand}"
                        Width="100" Height="32" Margin="8,0" FontSize="13"
                        ToolTip="打开文件选择对话框，选择要抠图的图片文件"/>
                <Button Grid.Column="2" Content="开始抠图" Command="{Binding StartProcessingCommand}"
                        Width="100" Height="32" Margin="0,0,8,0" FontSize="13"
                        ToolTip="对已选择的图片文件执行智能抠图"/>

                <!-- 参数区 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">

                    <!-- 模型选择 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <TextBlock Text="模型:" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                  SelectedValue="{Binding SelectedModelName}"
                                  SelectedValuePath="Name"
                                  DisplayMemberPath="DisplayText"
                                  Width="240" Height="26" FontSize="12"
                                  ToolTip="选择要使用的抠图模型"/>
                    </StackPanel>

                    <!-- Alpha Matting 开关 -->
                    <CheckBox Content="Alpha Matting" IsChecked="{Binding AlphaMatting}"
                              VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"
                              ToolTip="启用后边缘更精细，但处理时间更长"/>

                    <!-- 输出格式 -->
                    <CheckBox Content="透明 PNG" IsChecked="{Binding OutputRgba}"
                              VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"
                              ToolTip="输出带透明通道的 PNG 格式（RGBA）"/>

                    <!-- 合成背景开关 -->
                    <CheckBox Content="合成背景" IsChecked="{Binding SynthesizeBackground}"
                              VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"
                              ToolTip="将抠图结果合成到纯色背景上"/>

                    <!-- 背景色预设按钮（仅在合成背景时显示） -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ShowBackgroundColorPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="白" Command="{Binding SetWhiteBackgroundCommand}"
                                Width="28" Height="24" Margin="0,0,3,0" FontSize="11"
                                Background="#FFFFFF" ToolTip="白色背景"/>
                        <Button Content="红" Command="{Binding SetRedBackgroundCommand}"
                                Width="28" Height="24" Margin="0,0,3,0" FontSize="11"
                                Background="#FF0000" Foreground="White" ToolTip="红色背景（证件照常用）"/>
                        <Button Content="蓝" Command="{Binding SetBlueBackgroundCommand}"
                                Width="28" Height="24" Margin="0,0,6,0" FontSize="11"
                                Background="#0000FF" Foreground="White" ToolTip="蓝色背景（证件照常用）"/>

                        <!-- RGB 输入 -->
                        <TextBlock Text="R:" VerticalAlignment="Center" FontSize="11" Margin="0,0,2,0"/>
                        <TextBox Text="{Binding BgRed, UpdateSourceTrigger=PropertyChanged}"
                                 Width="36" Height="22" FontSize="11" TextAlignment="Center"
                                 ToolTip="红色分量 (0-255)"/>
                        <TextBlock Text="G:" VerticalAlignment="Center" FontSize="11" Margin="4,0,2,0"/>
                        <TextBox Text="{Binding BgGreen, UpdateSourceTrigger=PropertyChanged}"
                                 Width="36" Height="22" FontSize="11" TextAlignment="Center"
                                 ToolTip="绿色分量 (0-255)"/>
                        <TextBlock Text="B:" VerticalAlignment="Center" FontSize="11" Margin="4,0,2,0"/>
                        <TextBox Text="{Binding BgBlue, UpdateSourceTrigger=PropertyChanged}"
                                 Width="36" Height="22" FontSize="11" TextAlignment="Center"
                                 ToolTip="蓝色分量 (0-255)"/>

                        <!-- 颜色预览 -->
                        <Rectangle Width="24" Height="24" RadiusX="3" RadiusY="3" Margin="6,0,0,0"
                                   Stroke="Gray" StrokeThickness="1">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{Binding BackgroundColorPreview}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="4" Content="打开文件" Command="{Binding OpenOutputFileCommand}"
                        Width="80" Height="32" Margin="4,0" FontSize="13"
                        ToolTip="在文件资源管理器中打开选中的输出文件"/>
                <Button Grid.Column="5" Content="清除结果" Command="{Binding ClearResultsCommand}"
                        Width="80" Height="32" Margin="4,0" FontSize="13"
                        ToolTip="清除所有抠图处理结果"/>
                <Button Grid.Column="6" Content="取消" Command="{Binding CancelCommand}"
                        Width="60" Height="32" Margin="4,0" FontSize="13">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanCancel}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ===== 错误提示条 ===== -->
        <Border Grid.Row="1" Background="#FFEBEE" Padding="8"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="✕" Width="30" Height="24"
                        Command="{Binding ClearResultsCommand}" FontSize="14"
                        Background="Transparent" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- ===== 主内容区：左右分栏 ===== -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240"/>  <!-- 结果列表 -->
                <ColumnDefinition Width="Auto"/>                <!-- 分隔线 -->
                <ColumnDefinition Width="*" MinWidth="400"/>    <!-- 详情预览 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧：结果列表 -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 结果列表标题 -->
                    <Border Grid.Row="0" Padding="8,6"
                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                        <TextBlock FontSize="14" FontWeight="SemiBold">
                            <Run Text="抠图结果 "/>
                            <Run Text="{Binding ResultCount, StringFormat=({0})}" FontSize="12" Foreground="Gray"/>
                        </TextBlock>
                    </Border>

                    <!-- 结果列表 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="2" CornerRadius="3"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 文件名 -->
                                        <TextBlock Grid.Row="0" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding InputPath}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 模型和尺寸信息 -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock FontSize="11" Foreground="Gray">
                                                <Run Text="模型: "/>
                                                <Run Text="{Binding ModelSummary, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="Gray" Margin="8,0,0,0">
                                                <Run Text="输出: "/>
                                                <Run Text="{Binding OutputSizeSummary, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- 格式和前景占比 -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock FontSize="11" Foreground="Gray">
                                                <Run Text="格式: "/>
                                                <Run Text="{Binding OutputFormatSummary, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{StaticResource InfoBrush}" Margin="8,0,0,0">
                                                <Run Text="前景: "/>
                                                <Run Text="{Binding ForegroundRatioSummary, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- 失败标记 -->
                                        <TextBlock Grid.Row="1" Text="✕ 抠图失败" FontSize="12"
                                                   Foreground="{StaticResource ErrorBrush}" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- 右侧：详情预览 -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="4" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 详情标题 -->
                    <Border Grid.Row="0" Padding="8,6"
                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="处理详情" Margin="0,0,8,0"/>
                            <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center"
                                       Text="{Binding SelectedResult.SizeSummary, Mode=OneWay, TargetNullValue='请选择左侧结果查看详情'}"/>
                        </StackPanel>
                    </Border>

                    <!-- 概览信息卡片 -->
                    <Border Grid.Row="1" Padding="12,8" Margin="8,8"
                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 左列 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                                <TextBlock FontSize="12" Foreground="Gray" Text="源文件"/>
                                <TextBlock FontSize="13" Text="{Binding SelectedResult.InputFileName, TargetNullValue='-'}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,4">
                                <TextBlock FontSize="12" Foreground="Gray" Text="输入尺寸"/>
                                <TextBlock FontSize="13" Text="{Binding SelectedResult.InputSizeSummary, TargetNullValue='-'}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,4">
                                <TextBlock FontSize="12" Foreground="Gray" Text="输出尺寸"/>
                                <TextBlock FontSize="13" Text="{Binding SelectedResult.OutputSizeSummary, TargetNullValue='-'}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0">
                                <TextBlock FontSize="12" Foreground="Gray" Text="前景占比"/>
                                <TextBlock FontSize="13" Text="{Binding SelectedResult.ForegroundRatioSummary, TargetNullValue='-'}"/>
                            </StackPanel>

                            <!-- 右列 -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                                <TextBlock FontSize="12" Foreground="Gray" Text="模型"/>
                                <TextBlock FontSize="13" Text="{Binding SelectedResult.ModelSummary, TargetNullValue='-'}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                                <TextBlock FontSize="12" Foreground="Gray" Text="输出格式"/>
                                <TextBlock FontSize="13" Text="{Binding SelectedResult.OutputFormatSummary, TargetNullValue='-'}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,4">
                                <TextBlock FontSize="12" Foreground="Gray" Text="输出文件"/>
                                <TextBlock FontSize="13" Text="{Binding SelectedResult.OutputFileName, TargetNullValue='-'}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- 错误详情（仅失败结果显示） -->
                    <Border Grid.Row="2" Padding="10,6" Margin="8,0" CornerRadius="3"
                            Background="#FFF3E0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedResult.IsSuccess}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="13" Foreground="{StaticResource ErrorBrush}"
                                   Text="{Binding SelectedResult.ErrorMessage, TargetNullValue='未知错误'}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- 无结果时的提示 -->
                    <TextBlock Grid.Row="3" FontSize="14" Foreground="Gray" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Text="选择左侧结果查看详情">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedResult}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 成功结果的预览文字 -->
                    <TextBlock Grid.Row="3" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{Binding SelectedPreviewText}"
                               TextWrapping="Wrap" Margin="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedResult}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底部状态栏 ===== -->
        <Border Grid.Row="3" Padding="8,4" Margin="0,8,0,0"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 进度条和统计 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="200" Height="12" Margin="0,0,8,0"
                                 Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock FontSize="12" VerticalAlignment="Center">
                        <Run Text="{Binding SuccessCount, Mode=OneWay}" Foreground="Green" FontWeight="SemiBold"/>
                        <Run Text=" 成功, "/>
                        <Run Text="{Binding FailedCount, Mode=OneWay}" Foreground="Red" FontWeight="SemiBold"/>
                        <Run Text=" 失败"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
