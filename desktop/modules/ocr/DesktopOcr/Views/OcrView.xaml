<UserControl x:Class="TTTools.OCR.Views.OcrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TTTools.OCR.ViewModels"
             xmlns:local="clr-namespace:TTTools.OCR.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <UserControl.Resources>
        <!-- BooleanToVisibility 转换器（WPF 内建） -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 成功状态颜色 -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
        <!-- 错误状态颜色 -->
        <SolidColorBrush x:Key="ErrorBrush" Color="#C62828"/>
        <!-- 高置信度文字颜色 -->
        <SolidColorBrush x:Key="HighConfBrush" Color="#1B5E20"/>
        <!-- 低置信度文字颜色 -->
        <SolidColorBrush x:Key="LowConfBrush" Color="#E65100"/>
        <!-- 正常置信度文字颜色 -->
        <SolidColorBrush x:Key="NormalConfBrush" Color="#212121"/>

        <!-- 文字行置信度颜色转换器 -->
        <local:ScoreToBrushConverter x:Key="ScoreToBrushConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
            <RowDefinition Height="Auto"/>  <!-- 状态栏 -->
            <RowDefinition Height="*"/>      <!-- 主内容区 -->
            <RowDefinition Height="Auto"/>  <!-- 底部状态 -->
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 服务状态指示 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceAvailable}" Value="True">
                                        <Setter Property="Fill" Value="Green"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ServiceStatusText}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <Button Grid.Column="1" Content="选择图片" Command="{Binding SelectFilesCommand}"
                        Width="100" Height="32" Margin="8,0" FontSize="13"
                        ToolTip="打开文件选择对话框，选择要识别的图片文件"/>
                <Button Grid.Column="2" Content="开始识别" Command="{Binding StartRecognitionCommand}"
                        Width="100" Height="32" Margin="0,0,8,0" FontSize="13"
                        ToolTip="对已选择的图片文件执行 OCR 识别"/>

                <!-- 置信度阈值滑块 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="置信度阈值:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                    <Slider Minimum="0.1" Maximum="1.0" Value="{Binding TextScore}"
                            Width="120" SmallChange="0.1" LargeChange="0.2"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                            ToolTip="低于此值的识别结果将被过滤"/>
                    <TextBlock Text="{Binding TextScore, StringFormat={}{0:F1}}" VerticalAlignment="Center"
                               FontSize="12" Width="30" Margin="6,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="4" Content="复制文本" Command="{Binding CopyTextCommand}"
                        Width="90" Height="32" Margin="4,0" FontSize="13"
                        ToolTip="复制选中识别结果的文本到剪贴板"/>
                <Button Grid.Column="5" Content="清除结果" Command="{Binding ClearResultsCommand}"
                        Width="90" Height="32" Margin="4,0" FontSize="13"
                        ToolTip="清除所有 OCR 识别结果"/>
            </Grid>
        </Border>

        <!-- ===== 错误提示条 ===== -->
        <Border Grid.Row="1" Background="#FFEBEE" Padding="8"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="✕" Width="30" Height="24"
                        Command="{Binding ClearResultsCommand}" FontSize="14"
                        Background="Transparent" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- ===== 主内容区：左右分栏 ===== -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>  <!-- 结果列表 -->
                <ColumnDefinition Width="Auto"/>               <!-- 分隔线 -->
                <ColumnDefinition Width="*" MinWidth="300"/>    <!-- 详情预览 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧：结果列表 -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 结果列表标题 -->
                    <Border Grid.Row="0" Padding="8,6"
                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                        <TextBlock FontSize="14" FontWeight="SemiBold">
                            <Run Text="识别结果 "/>
                            <Run Text="{Binding ResultCount, StringFormat=({0})}" FontSize="12" Foreground="Gray"/>
                        </TextBlock>
                    </Border>

                    <!-- 结果列表 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="2" CornerRadius="3"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 文件名 -->
                                        <TextBlock Grid.Row="0" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FilePath}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 状态和统计 -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock FontSize="11" Foreground="Gray">
                                                <Run Text="图片: "/>
                                                <Run Text="{Binding ImageSizeSummary, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="Gray" Margin="8,0,0,0">
                                                <Run Text="行数: "/>
                                                <Run Text="{Binding LineCount, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- 耗时和置信度 -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock FontSize="11" Foreground="Gray">
                                                <Run Text="耗时: "/>
                                                <Run Text="{Binding ElapsedTotal, StringFormat={}{0:F2}s, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="8,0,0,0">
                                                <Run Text="置信度: "/>
                                                <Run Text="{Binding AvgScore, StringFormat={}{0:P1}, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- 失败标记 -->
                                        <TextBlock Grid.Row="1" Text="✕ 识别失败" FontSize="12"
                                                   Foreground="{StaticResource ErrorBrush}" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- 右侧：详情预览 -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="4" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 详情标题 -->
                    <Border Grid.Row="0" Padding="8,6"
                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="识别详情" Margin="0,0,8,0"/>
                            <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center"
                                       Text="{Binding SelectedResult.ElapsedSummary, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>

                    <!-- 统计信息 -->
                    <Border Grid.Row="1" Padding="8,4" Margin="8,4"
                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            CornerRadius="3">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="Gray"
                                       Text="{Binding SelectedResult.EngineName, StringFormat='引擎: {0}', TargetNullValue='引擎: -'}"
                                       Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" Foreground="Gray" Margin="0,0,16,0"
                                           Text="{Binding SelectedResult.ImageSizeSummary, StringFormat='图片尺寸: {0}', TargetNullValue='图片尺寸: -'}"/>
                                <TextBlock FontSize="12" Foreground="Green"
                                           Text="{Binding SelectedResult.HighConfidenceCount, StringFormat='高置信: {0} 行'}"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource LowConfBrush}" Margin="12,0,0,0"
                                           Text="{Binding SelectedResult.LowConfidenceCount, StringFormat='低置信: {0} 行'}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 识别内容区域 -->
                    <Border Grid.Row="2" Margin="8,8,8,8">
                        <Grid>
                            <!-- 无结果时的提示 -->
                            <TextBlock FontSize="14" Foreground="Gray" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Text="选择左侧结果查看详情">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedResult}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 有结果时显示文字行列表 -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedResult.TextLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" Margin="0,2" CornerRadius="3"
                                                Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 置信度指示器 -->
                                                <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="Gray"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHighConfidence}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource HighConfBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLowConfidence}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource LowConfBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <!-- 文字内容 -->
                                                <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                           FontSize="14" TextWrapping="Wrap"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource NormalConfBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLowConfidence}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource LowConfBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- 置信度分数 -->
                                                <TextBlock Grid.Column="2" Text="{Binding ScorePercent}"
                                                           FontSize="11" Margin="12,0,0,0"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLowConfidence}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource LowConfBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底部状态栏 ===== -->
        <Border Grid.Row="3" Padding="8,4" Margin="0,8,0,0"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 进度条（运行中时显示） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="200" Height="12" Margin="0,0,8,0"
                                 Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock FontSize="12" VerticalAlignment="Center">
                        <Run Text="{Binding SuccessCount, Mode=OneWay}" Foreground="Green" FontWeight="SemiBold"/>
                        <Run Text=" 成功, "/>
                        <Run Text="{Binding FailedCount, Mode=OneWay}" Foreground="Red" FontWeight="SemiBold"/>
                        <Run Text=" 失败"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
