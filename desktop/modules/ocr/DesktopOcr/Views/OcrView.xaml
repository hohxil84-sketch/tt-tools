<UserControl x:Class="TTTools.OCR.Views.OcrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TTTools.OCR.ViewModels"
             xmlns:local="clr-namespace:TTTools.OCR.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <UserControl.Resources>
        <!-- BooleanToVisibility 转换器（WPF 内建） -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 成功状态颜色 -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
        <!-- 错误状态颜色 -->
        <SolidColorBrush x:Key="ErrorBrush" Color="#C62828"/>
        <!-- 低置信度 XX 占位符颜色 -->
        <SolidColorBrush x:Key="LowConfReplacementBrush" Color="#D32F2F"/>
        <!-- 正常文本颜色 -->
        <SolidColorBrush x:Key="NormalTextBrush" Color="#212121"/>

        <!-- 文件路径到缩略图转换器 -->
        <local:FilePathToThumbnailConverter x:Key="ThumbnailConverter"/>

        <!-- 结果列表项：选中时背景色 -->
        <Style x:Key="ResultListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}"
                                CornerRadius="4" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
            <RowDefinition Height="Auto"/>  <!-- 错误提示条 -->
            <RowDefinition Height="*"/>      <!-- 主内容区 -->
            <RowDefinition Height="Auto"/>  <!-- 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 服务状态指示 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServiceAvailable}" Value="True">
                                        <Setter Property="Fill" Value="Green"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ServiceStatusText}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <Button Grid.Column="1" Content="选择图片" Command="{Binding SelectFilesCommand}"
                        Width="100" Height="32" Margin="8,0" FontSize="13"
                        ToolTip="打开文件选择对话框，选择要识别的图片文件"/>
                <Button Grid.Column="2" Content="开始识别" Command="{Binding StartRecognitionCommand}"
                        Width="100" Height="32" Margin="0,0,8,0" FontSize="13"
                        ToolTip="对已选择的图片文件执行 OCR 识别"/>

                <!-- 置信度阈值滑块（百分比） -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="置信度阈值:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding TextScorePercent}"
                            Width="120" SmallChange="5" LargeChange="10"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            ToolTip="低于此百分比的识别文字将用 XX 替换"/>
                    <TextBlock Text="{Binding TextScorePercent, StringFormat={}{0}%}" VerticalAlignment="Center"
                               FontSize="12" Width="40" Margin="6,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="4" Content="复制文本" Command="{Binding CopyTextCommand}"
                        Width="90" Height="32" Margin="4,0" FontSize="13"
                        ToolTip="复制选中识别结果的文本到剪贴板"/>
                <Button Grid.Column="5" Content="清除结果" Command="{Binding ClearResultsCommand}"
                        Width="90" Height="32" Margin="4,0" FontSize="13"
                        ToolTip="清除所有 OCR 识别结果"/>
            </Grid>
        </Border>

        <!-- ===== 错误提示条 ===== -->
        <Border Grid.Row="1" Background="#FFEBEE" Padding="8"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="✕" Width="30" Height="24"
                        Command="{Binding ClearResultsCommand}" FontSize="14"
                        Background="Transparent" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- ===== 主内容区：左右分栏 ===== -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>  <!-- 结果列表 -->
                <ColumnDefinition Width="Auto"/>               <!-- 分隔线 -->
                <ColumnDefinition Width="*" MinWidth="300"/>    <!-- 详情预览 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧：结果列表（含缩略图） -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 结果列表标题 -->
                    <Border Grid.Row="0" Padding="8,6"
                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                        <TextBlock FontSize="14" FontWeight="SemiBold">
                            <Run Text="识别结果 "/>
                            <Run Text="{Binding ResultCount, StringFormat=({0})}" FontSize="12" Foreground="Gray"/>
                        </TextBlock>
                    </Border>

                    <!-- 结果列表（每项含缩略图 + 信息） -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult}"
                             ItemContainerStyle="{StaticResource ResultListBoxItemStyle}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 缩略图（点击查看原图） -->
                                    <Border Grid.Column="0" Width="56" Height="56"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                            BorderThickness="1" CornerRadius="2"
                                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                            VerticalAlignment="Top" Margin="0,0,8,0"
                                            Cursor="Hand" Tag="{Binding FilePath}"
                                            MouseLeftButtonDown="OnThumbnailClick"
                                            ToolTip="点击查看原图">
                                        <Image Source="{Binding FilePath, Converter={StaticResource ThumbnailConverter}}"
                                               Stretch="Uniform" Width="52" Height="52"/>
                                    </Border>

                                    <!-- 文件信息 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <!-- 文件名 -->
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="180"
                                                   ToolTip="{Binding FilePath}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 统计信息 -->
                                        <StackPanel Margin="0,2,0,0">
                                            <TextBlock FontSize="11" Foreground="Gray">
                                                <Run Text="行数: "/>
                                                <Run Text="{Binding LineCount, Mode=OneWay}"/>
                                                <Run Text="  耗时: "/>
                                                <Run Text="{Binding ElapsedTotal, StringFormat={}{0:F1}s, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock FontSize="11">
                                                <Run Text="高: "/>
                                                <Run Text="{Binding HighConfidenceCount, Mode=OneWay}" Foreground="Green" FontWeight="SemiBold"/>
                                                <Run Text="  低: "/>
                                                <Run Text="{Binding LowConfidenceCount, Mode=OneWay}" Foreground="Red" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- 失败标记 -->
                                        <TextBlock Text="✕ 识别失败" FontSize="11"
                                                   Foreground="{StaticResource ErrorBrush}" Margin="0,1,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- 右侧：格式化文本详情 -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="4" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 详情标题 -->
                    <Border Grid.Row="0" Padding="8,6"
                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="识别详情" Margin="0,0,8,0"/>
                            <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center"
                                       Text="{Binding SelectedResult.ElapsedSummary, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>

                    <!-- 统计信息 -->
                    <Border Grid.Row="1" Padding="8,4" Margin="8,4"
                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            CornerRadius="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12" Foreground="Gray" Margin="0,0,12,0"
                                       Text="{Binding SelectedResult.EngineName, StringFormat='引擎: {0}', TargetNullValue='引擎: -'}"/>
                            <TextBlock FontSize="12" Foreground="Gray" Margin="0,0,12,0"
                                       Text="{Binding SelectedResult.ImageSizeSummary, StringFormat='图片: {0}', TargetNullValue='图片: -'}"/>
                            <TextBlock FontSize="12" Foreground="Green">
                                <Run Text="高置信: "/>
                                <Run Text="{Binding SelectedResult.HighConfidenceCount, Mode=OneWay}"/>
                                <Run Text=" 行"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="Red" Margin="12,0,0,0">
                                <Run Text="已遮: "/>
                                <Run Text="{Binding SelectedResult.LowConfidenceCount, Mode=OneWay}"/>
                                <Run Text=" 行"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 格式化文本展示区 -->
                    <Border Grid.Row="2" Margin="8,8,8,8">
                        <Grid>
                            <!-- 无结果时的提示 -->
                            <TextBlock FontSize="14" Foreground="Gray" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Text="选择左侧结果查看文字识别详情">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedResult}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 有结果时按原始排版展示，低置信度行显示红色 XX -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedResult}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <ItemsControl ItemsSource="{Binding SelectedResult.DisplayLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 每行：根据原图坐标缩进，低置信度显示红色 XX -->
                                        <TextBlock FontSize="15" FontFamily="Microsoft YaHei"
                                                   LineHeight="24" TextWrapping="Wrap"
                                                   Padding="{Binding IndentThickness}"
                                                   ToolTip="{Binding OriginalText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding DisplayText}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource NormalTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowConfidence}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource LowConfReplacementBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底部状态栏 ===== -->
        <Border Grid.Row="3" Padding="8,4" Margin="0,8,0,0"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 进度条（运行中时显示） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="200" Height="12" Margin="0,0,8,0"
                                 Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock FontSize="12" VerticalAlignment="Center">
                        <Run Text="{Binding SuccessCount, Mode=OneWay}" Foreground="Green" FontWeight="SemiBold"/>
                        <Run Text=" 成功, "/>
                        <Run Text="{Binding FailedCount, Mode=OneWay}" Foreground="Red" FontWeight="SemiBold"/>
                        <Run Text=" 失败"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
