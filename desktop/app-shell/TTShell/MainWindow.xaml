<Window x:Class="TTShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TTShell"
        xmlns:views="clr-namespace:TTShell.Views"
        xmlns:workbench="clr-namespace:TTTools.FileWorkbench.Views;assembly=TTTools.FileWorkbench"
        xmlns:ocr="clr-namespace:TTTools.OCR.Views;assembly=TTTools.OCR"
        xmlns:preflight="clr-namespace:TTTools.PreflightCheck.Views;assembly=TTTools.PreflightCheck"
        xmlns:copy="clr-namespace:TTTools.AiCopyClient.Views;assembly=TTTools.AiCopyClient"
        xmlns:render="clr-namespace:TTTools.AiRenderClient.Views;assembly=TTTools.AiRenderClient"
        xmlns:resize="clr-namespace:TTTools.ResizeImage.Views;assembly=TTTools.ResizeImage"
        xmlns:format="clr-namespace:TTTools.FormatConvert.Views;assembly=TTTools.FormatConvert"
        xmlns:pdfimg="clr-namespace:TTTools.PdfImageConvert.Views;assembly=TTTools.PdfImageConvert"
        xmlns:idphoto="clr-namespace:TTTools.IdPhoto.Views;assembly=TTTools.IdPhoto"
        xmlns:removebg="clr-namespace:TTTools.RemoveBg.Views;assembly=TTTools.RemoveBg"
        xmlns:auth="clr-namespace:TTTools.AuthDevice.Views;assembly=TTTools.AuthDevice"
        xmlns:expset="clr-namespace:TTTools.ExportSettings.Views;assembly=TTTools.ExportSettings"
        xmlns:aiimg="clr-namespace:TTTools.AiImageToolsClient.Views;assembly=TTTools.AiImageToolsClient"
        Title="Alphoria"
        MinHeight="680"
        MinWidth="1024"
        Height="768"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <!-- WindowChrome：完全自定义标题栏，系统按钮由 WPF 绘制 -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CaptionHeight="32"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- ========== 主窗口布局：标题栏 + 侧栏+内容区 + 状态栏 ========== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题栏 ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Source="pack://siteoforigin:,,,/Resources/app-icon.png"
                           Width="18" Height="18"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                    <TextBlock Text="Alphoria"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 登录 -->
                <Button Grid.Column="2"
                        x:Name="UserEntryButton"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="👤 登录"
                        Height="26"
                        Padding="10,0"
                        FontSize="12"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Cursor="Hand" Click="OnUserEntryClick"
                        ToolTip="登录 / 设备状态" />

                <!-- 切换主题 -->
                <Button Grid.Column="3"
                        x:Name="ThemeToggleButton"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="🌙"
                        Width="28" Height="26"
                        FontSize="13"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="OnThemeToggle"
                        ToolTip="切换浅色/深色主题" />

                <!-- 右侧留白：让系统按钮不紧贴主题按钮 -->
                <Border Grid.Column="4" Width="8" />

                <!-- 最小化 -->
                <Button Grid.Column="5"
                        x:Name="MinimizeButton"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="&#xE921;"
                        Width="46" Height="32"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Cursor="Hand" Click="OnMinimizeClick"
                        MouseEnter="OnSystemButtonMouseEnter"
                        MouseLeave="OnSystemButtonMouseLeave"
                        ToolTip="最小化" />

                <!-- 最大化 / 还原 -->
                <Button Grid.Column="6"
                        x:Name="MaxRestoreButton"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="&#xE922;"
                        Width="46" Height="32"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Cursor="Hand" Click="OnMaxRestoreClick"
                        MouseEnter="OnSystemButtonMouseEnter"
                        MouseLeave="OnSystemButtonMouseLeave"
                        ToolTip="最大化" />

                <!-- 关闭 -->
                <Button Grid.Column="7"
                        x:Name="CloseButton"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="&#xE8BB;"
                        Width="46" Height="32"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Cursor="Hand" Click="OnCloseClick"
                        MouseEnter="OnCloseButtonMouseEnter"
                        MouseLeave="OnCloseButtonMouseLeave"
                        ToolTip="关闭" />
            </Grid>
        </Border>

        <!-- ==================== 主体区域 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 导航侧栏 -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                <StackPanel Margin="0,4,0,0">
                    <!-- 首页 -->
                    <Button x:Name="NavHome" Style="{StaticResource NavButtonStyle}"
                            Content="🏠  首页" Tag="Home" Click="OnNavigationClick" />

                    <Separator Margin="8,3" Background="{DynamicResource DividerBrush}" />

                    <!-- 文件 / 印前 -->
                    <Button x:Name="NavFileWorkbench" Style="{StaticResource NavButtonStyle}"
                            Content="📁  文件工作台" Tag="FileWorkbench" Click="OnNavigationClick" />
                    <Button x:Name="NavOcr" Style="{StaticResource NavButtonStyle}"
                            Content="📝  OCR 文字识别" Tag="Ocr" Click="OnNavigationClick" />
                    <Button x:Name="NavPreflight" Style="{StaticResource NavButtonStyle}"
                            Content="🔍  印前检查" Tag="Preflight" Click="OnNavigationClick" />

                    <Separator Margin="8,3" Background="{DynamicResource DividerBrush}" />

                    <!-- AI 工具 -->
                    <Button x:Name="NavAiCopy" Style="{StaticResource NavButtonStyle}"
                            Content="🤖  AI 文案生成" Tag="AiCopy" Click="OnNavigationClick" />
                    <Button x:Name="NavAiRender" Style="{StaticResource NavButtonStyle}"
                            Content="🎨  效果图生成" Tag="AiRender" Click="OnNavigationClick" />
                    <Button x:Name="NavAiImageTools" Style="{StaticResource NavButtonStyle}"
                            Content="🖼️  AI 图片工具" Tag="AiImageTools" Click="OnNavigationClick" />

                    <Separator Margin="8,3" Background="{DynamicResource DividerBrush}" />

                    <!-- 图片处理 -->
                    <Button x:Name="NavResizeImage" Style="{StaticResource NavButtonStyle}"
                            Content="📐  图片改尺寸" Tag="ResizeImage" Click="OnNavigationClick" />
                    <Button x:Name="NavFormatConvert" Style="{StaticResource NavButtonStyle}"
                            Content="🖼️  格式转换" Tag="FormatConvert" Click="OnNavigationClick" />
                    <Button x:Name="NavPdfImageConvert" Style="{StaticResource NavButtonStyle}"
                            Content="📄  PDF/图片互转" Tag="PdfImageConvert" Click="OnNavigationClick" />
                    <Button x:Name="NavIdPhoto" Style="{StaticResource NavButtonStyle}"
                            Content="📸  证件照换底色" Tag="IdPhoto" Click="OnNavigationClick" />
                    <Button x:Name="NavRemoveBg" Style="{StaticResource NavButtonStyle}"
                            Content="✂️  智能抠图" Tag="RemoveBg" Click="OnNavigationClick" />

                    <Separator Margin="8,3" Background="{DynamicResource DividerBrush}" />

                    <Button x:Name="NavExport" Style="{StaticResource NavButtonStyle}"
                            Content="📤  导出" Tag="Export" Click="OnNavigationClick" />
                    <Button x:Name="NavLogViewer" Style="{StaticResource NavButtonStyle}"
                            Content="📋  日志查看" Tag="LogViewer" Click="OnNavigationClick" />
                    <Button x:Name="NavSettings" Style="{StaticResource NavButtonStyle}"
                            Content="⚙️  设置" Tag="Settings" Click="OnNavigationClick" />
                </StackPanel>
            </Border>

            <!-- 分隔线 -->
            <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

            <!-- 主内容区 -->
            <ContentControl Grid.Column="2" x:Name="MainContent"
                            Background="{DynamicResource BackgroundBrush}">
                <views:HomePage />
            </ContentControl>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <StatusBar Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock x:Name="VersionText" Text="v0.1.0" Margin="0,0,8,0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
