<Window x:Class="TTShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TTShell"
        xmlns:views="clr-namespace:TTShell.Views"
        Title="TT Tools"
        MinHeight="680"
        MinWidth="1024"
        Height="768"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <!-- ========== 主窗口布局：标题栏 + 侧栏+内容区 + 状态栏 ========== -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 标题栏 -->
            <RowDefinition Height="48" />
            <!-- 主体区域 -->
            <RowDefinition Height="*" />
            <!-- 状态栏 -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题栏 ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 应用名称 -->
                <TextBlock Grid.Column="0"
                           Text="TT Tools"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <!-- 主题切换按钮 -->
                <Button Grid.Column="2"
                        x:Name="ThemeToggleButton"
                        Content="🌙"
                        Width="36"
                        Height="36"
                        FontSize="16"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnThemeToggle"
                        ToolTip="切换浅色/深色主题" />

                <!-- 窗口控制按钮 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="─"
                            Width="36" Height="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Click="OnMinimize"
                            ToolTip="最小化" />
                    <Button x:Name="MaxRestoreButton"
                            Content="□"
                            Width="36" Height="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Click="OnMaximizeRestore"
                            ToolTip="最大化/还原" />
                    <Button Content="✕"
                            Width="36" Height="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Click="OnClose"
                            ToolTip="关闭" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体区域 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 导航侧栏 -->
                <ColumnDefinition Width="200" />
                <!-- 分隔线 -->
                <ColumnDefinition Width="1" />
                <!-- 主内容区 -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 导航侧栏 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <!-- 首页 -->
                        <Button x:Name="NavHome"
                                Style="{StaticResource NavButtonStyle}"
                                Content="🏠  首页"
                                Tag="Home"
                                Click="OnNavigationClick" />
                        <!-- 分隔线 -->
                        <Separator Margin="16,8" Background="{DynamicResource DividerBrush}" />
                        <!-- 功能模块入口（占位） -->
                        <Button x:Name="NavFileWorkbench"
                                Style="{StaticResource NavButtonStyle}"
                                Content="📁  文件工作台"
                                Tag="FileWorkbench"
                                Click="OnNavigationClick" />
                        <Button x:Name="NavAiTools"
                                Style="{StaticResource NavButtonStyle}"
                                Content="🤖  AI 工具"
                                Tag="AiTools"
                                Click="OnNavigationClick" />
                        <!-- 分隔线 -->
                        <Separator Margin="16,8" Background="{DynamicResource DividerBrush}" />
                        <Button x:Name="NavExport"
                                Style="{StaticResource NavButtonStyle}"
                                Content="📤  导出"
                                Tag="Export"
                                Click="OnNavigationClick" />
                        <Button x:Name="NavSettings"
                                Style="{StaticResource NavButtonStyle}"
                                Content="⚙️  设置"
                                Tag="Settings"
                                Click="OnNavigationClick" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 分隔线 -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BorderBrush}" />

            <!-- 主内容区（页面切换容器） -->
            <ContentControl Grid.Column="2"
                            x:Name="MainContent"
                            Background="{DynamicResource BackgroundBrush}">
                <!-- 默认显示首页 -->
                <views:HomePage />
            </ContentControl>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <StatusBar Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock x:Name="VersionText" Text="v0.1.0" Margin="0,0,8,0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
