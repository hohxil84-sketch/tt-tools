<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon />
    <RootNamespace>TTShell</RootNamespace>
    <AssemblyName>TTShell</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>TT Tools Team</Authors>
    <Description>TT Tools - Windows 桌面客户端主程序外壳</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 文件/基础工具 -->
    <ProjectReference Include="..\..\modules\file-workbench\DesktopFileWorkbench\DesktopFileWorkbench.csproj" />
    <ProjectReference Include="..\..\modules\ocr\DesktopOcr\DesktopOcr.csproj" />
    <ProjectReference Include="..\..\modules\preflight-check\DesktopPreflightCheck\DesktopPreflightCheck.csproj" />
    <!-- AI 工具 -->
    <ProjectReference Include="..\..\modules\ai-copy-client\DesktopAiCopyClient\DesktopAiCopyClient.csproj" />
    <ProjectReference Include="..\..\modules\ai-render-client\DesktopAiRenderClient\DesktopAiRenderClient.csproj" />
    <ProjectReference Include="..\..\modules\ai-image-tools-client\DesktopAiImageToolsClient\DesktopAiImageToolsClient.csproj" />
    <!-- 图片处理 -->
    <ProjectReference Include="..\..\modules\resize-image\DesktopResizeImage\DesktopResizeImage.csproj" />
    <ProjectReference Include="..\..\modules\format-convert\DesktopFormatConvert\DesktopFormatConvert.csproj" />
    <ProjectReference Include="..\..\modules\pdf-image-convert\DesktopPdfImageConvert\DesktopPdfImageConvert.csproj" />
    <ProjectReference Include="..\..\modules\id-photo\DesktopIdPhoto\DesktopIdPhoto.csproj" />
    <ProjectReference Include="..\..\modules\remove-bg\DesktopRemoveBg\DesktopRemoveBg.csproj" />
    <!-- 系统 -->
    <ProjectReference Include="..\..\modules\auth-device\DesktopAuthDevice\DesktopAuthDevice.csproj" />
    <ProjectReference Include="..\..\modules\job-system\DesktopJobSystem\DesktopJobSystem.csproj" />
    <ProjectReference Include="..\..\modules\export-settings\DesktopExportSettings\DesktopExportSettings.csproj" />
  </ItemGroup>

</Project>
